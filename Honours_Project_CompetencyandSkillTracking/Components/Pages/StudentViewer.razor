@page "/studentviewer/{StudentId}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UserService service
@inject AppDbContext DbContext

<div style="margin-bottom:10px">
    <button class="module-button" @onclick="ReturnToSelection">
        ← Back to Selection
    </button>
</div>

<h3>Student Details</h3>

@if (student != null)
{
    <div>
        <h4>@student.UserName</h4>
        <p>Student ID: @student.StudentId</p>
        <p>Email: @student.StEmail</p>
        <p>Full Name: @student.UserName</p>
        <p>Enrolled Modules: @string.Join(", ", student.Courses.Select(c => c.Name))</p>
        <p>Assignments: @string.Join(", ", student.Submissions.Select(s => $"{s.Assignment.Name} (Score: {s.Score})"))</p>

        <h4>Achieved Competencies</h4>

        @if (groupedCompetencies.Any())
        {
            <ul>
                @foreach (var item in groupedCompetencies)
                {
                    <li style="margin-bottom:15px;">
                        <strong>
                            @item.BestAttempt.CompetencyLevel.Competency.CompetencyName
                        </strong>
                        <p>Level: @item.BestAttempt.CompetencyLevel.LevelNumber</p>
                        <p>
                            Best Score: @item.BestAttempt.MasteryPoints
                            <br />
                            Achieved on: @item.BestAttempt.AchievedDate.ToString("yyyy-MM-dd")
                        </p>

                        <p>
                            Achieved in modules:
                            @string.Join(", ", item.Modules.Select(m => $"{m.ModuleName} ({m.ModCode})"))
                        </p>
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No competencies achieved yet.</p>
        }
    </div>
}
else
{
    <p>Loading didn't work</p>
}

@code {
    [Parameter] public string StudentId { get; set; }

    private User? student;
    private List<CompetencyAchievement> achievedCompetencies = new();
    private List<GroupedCompetencyView> groupedCompetencies = new();

    protected override async Task OnInitializedAsync()
    {
        student = await service.GetUserByIdAsync(StudentId);

        if (student != null)
        {
            achievedCompetencies = await DbContext.CompetencyAchievements
                .Where(a => a.StudentId == student.StudentId)
                .Include(a => a.CompetencyLevel)
                    .ThenInclude(cl => cl.Competency)
                .Include(a => a.Module)
                .OrderByDescending(a => a.AchievedDate)
                .ToListAsync();

            groupedCompetencies = achievedCompetencies
                .GroupBy(a => a.CompetencyLevelId)
                .Select(g => new GroupedCompetencyView
                {
                    BestAttempt = g.OrderByDescending(a => a.MasteryPoints).First(),

                    Modules = g.Select(a => a.Module)
                               .GroupBy(m => m.DatabaseID)
                               .Select(m => m.First())
                               .ToList()
                })
                .ToList();
        }
    }
    private void ReturnToSelection()
    {
        NavigationManager.NavigateTo("/studentselection");
    }

    // Helper class
    private class GroupedCompetencyView
    {
        public CompetencyAchievement BestAttempt { get; set; } = null!;
        public List<ModuleData> Modules { get; set; } = new();
    }
}