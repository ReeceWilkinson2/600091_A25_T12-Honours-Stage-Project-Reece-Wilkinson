@page "/studentviewer/{StudentId}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UserService service


<div style="margin-bottom:10px">
    <button class="module-button" @onclick="ReturnToSelection">
        ← Back to Selection
    </button>
</div>

<h3>Student Details</h3>

@if (student != null)
{
    <div>
        <h4>@student.UserName</h4>
        <p>Student ID: @student.StudentId</p>
        <p>Email: @student.StEmail</p>
        <p>Full Name: @student.UserName</p>
        <p>Enrolled Modules: @string.Join(", ", student.Courses.Select(c => c.Name))</p>
        <p>Assignments: @string.Join(", ", student.Submissions.Select(s => $"{s.Assignment.Name} (Score: {s.Score})"))</p>
        @* <p>Outcomes: @string.Join(", ", student.Submissions.OutcomeResults.Select(s => $"{s.Assignment.Name} (Score: {s.Score})"))</p> *@
    </div>
}
else
{
    <p>Loading didn't work</p>
}

@code {
    [Parameter] public string StudentId { get; set; }
    private User? student;

    protected override async Task OnInitializedAsync()
    {
        // Fetch the detailed information for the student using their StudentId
        student = await service.GetUserByIdAsync(StudentId);
    }

    private void ReturnToSelection()
    {
        NavigationManager.NavigateTo("/studentselection");
    }
}