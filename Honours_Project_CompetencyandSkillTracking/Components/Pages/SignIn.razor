@page "/signin"
@rendermode InteractiveServer
@layout LoggedOutLayout
@inject NavigationManager NavigationManager
@inject UserService UserService
@inject AuthStateService AuthState
@inject Blazored.LocalStorage.ILocalStorageService localStorage

<PageTitle>SignIn</PageTitle>

<div class="body">
	<div class="form-body">
		<div class="form-wrapper">
			<EditForm Model="@form" OnValidSubmit="LogInUser">
				<DataAnnotationsValidator></DataAnnotationsValidator>
				<ValidationSummary></ValidationSummary>
				<h1>Login</h1>
				<div class="input-box">
					<InputText @bind-Value="@form.Email" id="email" class="input" placeholder="Email" type="email"></InputText>
					<i class="bx bxs-user"></i>
				</div>
				<div class="input-box">
					<InputText @bind-Value="@form.Password" id="password" class="input" placeholder="Password" type="password"></InputText>
					<i class="bx bxs-lock"></i>
				</div>
				<div class="remember-forgot">
					<a href="/PasswordReset">Forgot Password?</a>
				</div>
				<button type="submit">Login</button>
			</EditForm>
			<div class="register">
				<p>Don't have an account? <a href="/signup">Sign up here!</a></p>
			</div>
		</div>
	</div>
</div>

@code {
	SignInForm form = new SignInForm();
	string ErrorMessage = "";

	private async Task LogInUser(EditContext context)
	{
		// Authenticate against the Students table
		var user = await UserService.AuthenticateAsync(form.Email, form.Password);

		if (user == null)
		{
			ErrorMessage = "Invalid email or password";
			StateHasChanged();
			return;
		}

		// Save StudentId (string) to local storage
		// await localStorage.SetItemAsync("UserId", user.StudentId);
		// await localStorage.SetItemAsync("UserRole", user.Role);

		// AuthState.SetUser(user.StudentId, user.Role);

		await AuthState.SetUserAsync(user.StudentId, user.Role);

		NavigationManager.NavigateTo("/");
	}
}
