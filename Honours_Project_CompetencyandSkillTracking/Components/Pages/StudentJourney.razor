@page "/studentjourney"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UserService service


@if (SelectedCourse == null)
{
    <h3>Select a Course</h3>

    <button @onclick="@(() => SelectCourse("Computer Science"))">
        Computer Science
    </button>

    <button @onclick="@(() => SelectCourse("Computer Science for Games Development"))">
        Computer Science for Games Development
    </button>

    <button @onclick="@(() => SelectCourse("Robotics and Artificial Intelligence"))">
        Computer Science for Robotics and Artificial Intelligence
    </button>

    <button @onclick="@(() => SelectCourse("Computing (Software Engineering)"))">
        Computer Science (Software Engineering)
    </button>
}
else
{
    <button @onclick="ClearSelection">← Back to Courses</button>

    <h3>@SelectedCourseName</h3>
    <Tabs>
        <Tab Title="Year 1" Active="true">
            <ChildContent>
                <h4>Core Modules</h4>
                <div class="module-group">
                    @foreach (var module in Year1Modules.Where(m => m.SelectionStatus == "Core"))
                    {
                        <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                            @module.ModuleName
                        </button>
                    }
                </div>
                <div class="year-container">
                    <div class="trimester">
                        <h4>T1</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year1Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year1Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="trimester">
                        <h4>T2</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year1Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year1Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </ChildContent>
        </Tab>

        <Tab Title="Year 2">
            <ChildContent>
                <h4>Core Modules</h4>
                <div class="module-group">
                    @foreach (var module in Year2Modules.Where(m => m.SelectionStatus == "Core"))
                    {
                        <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                            @module.ModuleName
                        </button>
                    }
                </div>
                <div class="year-container">
                    <div class="trimester">
                        <h4>T1</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year2Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year2Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="trimester">
                        <h4>T2</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year2Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year2Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button"@onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </ChildContent>
        </Tab>

        <Tab Title="Year 3">
            <ChildContent>
                <h4>Elective Modules</h4>
                <div class="module-group">
                    @foreach (var module in Year3Modules.Where(m => m.SelectionStatus == "Elective"))
                    {
                        <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                            @module.ModuleName
                        </button>
                    }
                </div>
                <div class="year-container">
                    <div class="trimester">
                        <h4>T1</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year3Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year3Modules.Where(m => m.Trimester == "T1" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>

                    <div class="trimester">
                        <h4>T2</h4>
                        <div class="module-columns">
                            <div class="module-group">
                                <h5>Compulsory</h5>
                                @foreach (var module in Year3Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Compulsory"))
                                {
                                    <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                            <div class="module-group">
                                <h5>Optional</h5>
                                @foreach (var module in Year3Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="module-button" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
                                    </button>
                                }
                            </div>
                        </div>
                    </div>
                </div>
        </ChildContent>
    </Tab>
</Tabs>
}


@code { 
    // need to make a service to load modules based on the year and show if they are optional or not.
    private string? SelectedCourse;
    private string? SelectedCourseName;

    private List<ModuleData> Year1Modules = new List<ModuleData>();
    private List<ModuleData> Year2Modules = new List<ModuleData>();
    private List<ModuleData> Year3Modules = new List<ModuleData>();

    private async Task SelectCourse(string courseName)
    {
        SelectedCourse = courseName;
        SelectedCourseName = courseName;

        Year1Modules = await service.GetModuleDataAsync(courseName, "4");
        Year2Modules = await service.GetModuleDataAsync(courseName, "5");
        Year3Modules = await service.GetModuleDataAsync(courseName, "6");
    }

    private void ClearSelection()
    {
        SelectedCourse = null;
        SelectedCourseName = null;

        Year1Modules.Clear();
        Year2Modules.Clear();
        Year3Modules.Clear();
    }

    private void LoadModuleDetails(ModuleData module)
    {
        // Needs to get all competencies for the module and show them some way - requires competency data.
        Console.WriteLine($"Loading details for module: {module.ModuleName}");
    }
}
