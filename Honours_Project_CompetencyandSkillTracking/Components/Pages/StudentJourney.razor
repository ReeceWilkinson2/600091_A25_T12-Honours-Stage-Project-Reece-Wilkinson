@page "/studentjourney"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UserService service
@inject CompetencyDataServices competencyService
@inject AuthStateService AuthState

@if (SelectedCourse == null)
{
    <h3>Student Journey</h3>
    <p>Please select your course</p>

    <button class="module-button" style="width: 100%; text-align: left; margin-bottom: 10px" @onclick="@(() => SelectCourse("Computer Science"))">
        Computer Science
    </button>

    <button class="module-button" style="width: 100%; text-align: left; margin-bottom: 10px" @onclick="@(() => SelectCourse("Computer Science for Games Development"))">
        Computer Science for Games Development
    </button>

    <button class="module-button" style="width: 100%; text-align: left; margin-bottom: 10px" @onclick="@(() => SelectCourse("Robotics and Artificial Intelligence"))">
        Computer Science for Robotics and Artificial Intelligence
    </button>

    <button class="module-button" style="width: 100%; text-align: left; margin-bottom: 10px" @onclick="@(() => SelectCourse("Computing (Software Engineering)"))">
        Computer Science (Software Engineering)
    </button>

    <div style="margin-top:20px">
        <button class="module-button" @onclick="GoToFullView">Go To Full View</button>
    </div>
}
