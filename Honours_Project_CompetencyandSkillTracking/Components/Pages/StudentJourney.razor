    </Tabs>
    @if (AllCompetencies.Any())
    {
        <div class="form-group" style="margin-bottom:15px">
            <label>Search Competencies:</label>
            <select class="form-control"
                    @onchange="OnCompetencyFilterChanged">
                <option value="">-- None --</option>
                @foreach (var comp in AllCompetencies.OrderBy(c => c.CompetencyCode))
                {
                    <option value="@comp.CompetencyCode">
                        @comp.CompetencyCode - @comp.CompetencyName
                    </option>
