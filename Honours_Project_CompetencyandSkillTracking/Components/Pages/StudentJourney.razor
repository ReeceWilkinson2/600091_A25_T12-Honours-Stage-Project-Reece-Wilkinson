                                <h5>Optional</h5>
                                @foreach (var module in Year2Modules.Where(m => m.Trimester == "T2" && m.SelectionStatus == "Optional"))
                                {
                                    <button class="@GetModuleButtonClass(module)" @onclick="() => LoadModuleDetails(module)">
                                        @module.ModuleName
