else if (SelectedCompetency == null)
{
    <div style="margin-bottom:20px">
        <button class="module-button" @onclick="ClearSelection2">
            ← Back to Modules
        </button>
    </div>
    <h3>@SelectedModuleName</h3>
    @if (ActiveModule != null && CanShowToggle(ActiveModule))
    {
        <div style="margin-bottom:15px">
            <button class="module-button"
                    @onclick="() => ToggleTempEnrollment(ActiveModule)">
                @(TempSelectedModules.Contains(ActiveModule.ModCode)
                        ? "Remove from Planned Modules"
                        : "Add to Planned Modules")
    </button>
</div>
}
    <h4>Competencies</h4>

    @if (student != null && ActiveModule != null)
    {
        @if (SelectedModuleCompetencies.Any())
        {
            @foreach (var competency in SelectedModuleCompetencies)
            {
                <button class="module-button" @onclick="() => LoadCompetencyDetails(competency)">
                    @competency.CompetencyCode - @competency.CompetencyName
                </button>
            }
        }
        else
        {
            <p>No competencies found for this module.</p>
        }
    }

    <h4 style="margin-top:30px">Submissions for this module</h4>
    @if (student != null && ActiveModule != null)
    {
        var relevantSubmissions = GetRelevantSubmissionsForModule();

        if (relevantSubmissions.Any())
        {
            <ul>
                @foreach (var submission in relevantSubmissions)
                {
                    <li>
                        Assignment: @submission.Assignment.Name |
                        Score: @submission.Score |
                        Submitted: @submission.SubmittedAt
                        <br />

                        @if (submission.Comments != null && submission.Comments.Any())
                        {
                            <ul>
                                @foreach (var comment in submission.Comments)
                                {
                                    <li>
                                        @comment.Comment
                                        @if (!string.IsNullOrEmpty(comment.AuthorName))
                                        {
                                            <em>(by @comment.AuthorName)</em>
                                        }
                                        @if (comment.CreatedAt.HasValue)
                                        {
                                            <small>- @comment.CreatedAt.Value.ToString("g")</small>
                                        }
                                    </li>
                                }
                            </ul>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <p>No relevant submissions found for this module.</p>
        }

    }
    <h4 style="margin-top:30px">Planned Grades (What-if Calculator)</h4>

    @if (ActiveModule != null && student != null)
    {
        if (ActiveAssignments.Any())
        {
            @foreach (var assignment in ActiveAssignments)
            {
                var realScore = GetRealSubmissionScore(assignment.Id);

                <div style="margin-bottom:10px; padding:10px; border:1px solid #ddd;">
                    <strong>@assignment.Name</strong>
                    <span> (Weight: @assignment.Weighting%)</span>

                    <br />

                    @if (realScore != null)
                    {
                        <span style="color:green;">
                            ✔ Submitted Score: @realScore
                        </span>
                    }
                    else
                    {
                        <label>Predicted Score:</label>

                        <input type="number"
                               min="0"
                               max="100"
                               step="0.1"
                               value="@(GetPlannedScore(ActiveModule.ModCode, assignment.Id) ?? 0)"
                               @onchange="async (e) => await SetPlannedScore(ActiveModule.ModCode, assignment.Id, e.Value)" />
                    }
                </div>
            }

            <div style="margin-top:15px; font-weight:bold;">
                Projected Overall Grade:
                @ProjectedGrade.ToString("F1")%
            </div>
        }
        else
        {
            <p>No assignments found for this module.</p>
        }
    }
}
else
{
    <div style="margin-bottom:20px">
        <button class="module-button" @onclick="() => SelectedCompetency = null">
            ← Back to Competencies
        </button>
    </div>

    <h3>@SelectedCompetency.CompetencyCode - @SelectedCompetency.CompetencyName</h3>

    <div class="competency-details">
        @if (SelectedCompetency.Levels != null && ActiveModule != null)
        {
            var relevantLevels = SelectedCompetency.Levels.Where(l => l.Modules.Any(clm => clm.Module.ModCode == ActiveModule.ModCode)) .OrderBy(l => l.LevelNumber);

            if (relevantLevels.Any())
            {
                @foreach (var level in relevantLevels)
                {
                    <div class="level-section">
                        <h4>Level @level.LevelNumber</h4>
                        <p>@level.Description</p>
                    </div>
                }
            }
            else
            {
                <p>No level information available.</p>
            }
        }

        <h4>Additional Notes</h4>
        <p>@SelectedCompetency.AdditionalNotes</p>
    </div>
    <div style="margin-bottom:20px">
        <button class="module-button" @onclick="NavigateToCompetencyProgress">
            View Achievement for this Competency
        </button>
    </div>
}

@code {
    private string? SelectedCourse;
    private string? SelectedCourseName;
    private string? SelectedModule;
    private string? SelectedModuleName;
    private User? student;
    private ModuleData? ActiveModule;
    private List<CompetencyData> SelectedModuleCompetencies = new();
    private CompetencyData? SelectedCompetency;

    private List<CompetencyData> AllCompetencies = new();
    private string? SelectedCompetencyFilterId;
    private CompetencyData? FilterCompetency;
    private HashSet<string> FilterCompetencyModuleCodes = new();
    private HashSet<string> TempSelectedModules = new();

    private Dictionary<long, double> PlannedAssignmentScores = new();
    Dictionary<string, PlannedModuleGrade> PlannedModules = new();
    private Dictionary<long, double> PlannedGrades = new();
    private List<Assignment> ActiveAssignments = new();
    private double ProjectedGrade = 0;

    private List<ModuleData> Year1Modules = new List<ModuleData>();
    private List<ModuleData> Year2Modules = new List<ModuleData>();
    private List<ModuleData> Year3Modules = new List<ModuleData>();

    private Dictionary<string, string> ModuleRestrictions = new Dictionary<string, string>
    {
        { "600086", "500083" }, // Parallel and Concurrent Programming needs Advanced Programming
        { "600098", "551455" }, // Games Architecture needs Graphics Programming
        { "662253", "662086" }  // Natural Language Processing needs Machine Learning
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrEmpty(AuthState.UserId))
            return;

        student = await service.GetUserByIdAsync(AuthState.UserId);

        StateHasChanged();
    }

    private void GoToFullView()
    {
        NavigationManager.NavigateTo("/studentjourneyfull");
    }

    private async Task SelectCourse(string courseName)
    {
        SelectedCourse = courseName;
        SelectedCourseName = courseName;

        Year1Modules = await service.GetModuleDataAsync(courseName, "4");
        Year2Modules = await service.GetModuleDataAsync(courseName, "5");
        Year3Modules = await service.GetModuleDataAsync(courseName, "6");

        AllCompetencies = await competencyService.GetAllCompetenciesAsync();
    }

    private void ClearSelection()
    {
        SelectedCourse = null;
        SelectedCourseName = null;
        SelectedModule = null;
        SelectedCompetency = null;

        SelectedCompetencyFilterId = null;
        FilterCompetency = null;
        FilterCompetencyModuleCodes.Clear();

        Year1Modules.Clear();
        Year2Modules.Clear();
        Year3Modules.Clear();
    }

    private void ClearSelection2()
    {
        SelectedCompetency = null;
        SelectedModule = null;

        SelectedCompetencyFilterId = null;
        FilterCompetency = null;
        FilterCompetencyModuleCodes.Clear();
    }

    private void OnCompetencyFilterChanged(ChangeEventArgs e)
    {
        SelectedCompetencyFilterId = e.Value?.ToString();

        var competency = AllCompetencies.FirstOrDefault(c => c.CompetencyCode == SelectedCompetencyFilterId);

        if (competency?.Levels != null)
        {
            FilterCompetencyModuleCodes = competency.Levels.SelectMany(l => l.Modules).Select(m => m.Module.ModCode).Where(m => !string.IsNullOrWhiteSpace(m)).ToHashSet();
        }
        else
        {
            FilterCompetencyModuleCodes.Clear();
        }
    }

    private string GetModuleButtonClass(ModuleData module)
    {
        var baseClass = "module-button";

        var isHighlighted = FilterCompetencyModuleCodes.Contains(module.ModCode);
        var isRestricted = IsModuleRestricted(module);
        var isEnrolled = IsEffectivelyEnrolled(module);

        if (isHighlighted)
        {
            baseClass += " module-button-highlight";
        }
        else if (!isEnrolled)
        {
            baseClass += " module-button-greyed";
        }

        if (isRestricted)
        {
            baseClass += " module-button-restricted";
        }

        return baseClass;
    }

    private async Task LoadModuleDetails(ModuleData module)
    {
        ActiveModule = module;
        SelectedModule = module.ModuleName;
        SelectedModuleName = module.ModuleName;

        ActiveAssignments = await GetAssignmentsForModule(module);
        ProjectedGrade = await CalculateOverallGrade(module);
    }

private List<Submission> GetRelevantSubmissionsForModule()
{
    if (student == null || ActiveModule == null)
        return new List<Submission>();

    var modCode = ActiveModule.ModCode;

    return student.Submissions
        .Where(sub =>
            sub.Assignment != null &&
            sub.Assignment.Course != null &&
            !string.IsNullOrWhiteSpace(sub.Assignment.Course.Code) &&
            ExtractModCodeFromCourse(sub.Assignment.Course.Code) == modCode)
        .ToList();
}

    private bool IsStudentEnrolledInModule(ModuleData module)
    {
        if (student == null || string.IsNullOrWhiteSpace(module.ModCode))
            return false;

        return student.Courses.Any(course =>
        {
            var courseModCode = ExtractModCodeFromCourse(course.Code);
            return string.Equals(courseModCode, module.ModCode, StringComparison.OrdinalIgnoreCase);
        });
    }

    private bool IsEffectivelyEnrolled(ModuleData module)
    {
        return IsStudentEnrolledInModule(module)
            || TempSelectedModules.Contains(module.ModCode);
    }

    private bool IsModuleRestricted(ModuleData module)
    {
        if (student == null)
            return false;

        if (string.IsNullOrEmpty(module.ModCode))
        {
            return false;
        }

        foreach (var restriction in ModuleRestrictions)
        {
            var restrictedModCode = restriction.Key;
            var requiredModCode = restriction.Value;

            if (string.Equals(module.ModCode, restrictedModCode, StringComparison.OrdinalIgnoreCase))
            {
                var isEnrolledInRequiredModule =
                    student.Courses.Any(course =>
                    {
                        var courseModCode = ExtractModCodeFromCourse(course.Code);
                        return string.Equals(courseModCode, requiredModCode, StringComparison.OrdinalIgnoreCase);
                    })
                    || TempSelectedModules.Contains(requiredModCode);
                return !isEnrolledInRequiredModule;
            }
        }
        return false;
    }


    private string ExtractModCodeFromCourse(string courseCode)
    {
        if (string.IsNullOrWhiteSpace(courseCode))
            return string.Empty;

        var trimmed = courseCode.Trim();
        var digits = new string(trimmed.TakeWhile(char.IsDigit).ToArray());

        if (digits.Length == 6)
            return digits;

        return string.Empty;
    }

    private int GetMaxOptionalSelections(string year, string trimester)
    {
        return (year, trimester) switch
        {
            ("5", "T1") => 1,
            ("5", "T2") => 2,
            ("6", "T1") => 2,
            ("6", "T2") => 2,
            _ => 0
        };
    }

    private string GetYearFromLevel(ModuleData module)
    {
        return module.Level switch
        {
            "4" => "1",
            "5" => "2",
            "6" => "3",
            _ => ""
        };
    }

    private int CountTotalSelectionsForTrimester(string level, string trimester)
    {
        int enrolled = student?.Courses.Count(course =>
        {
            var modCode = ExtractModCodeFromCourse(course.Code);

            var module = Year1Modules
                .Concat(Year2Modules)
                .Concat(Year3Modules)
                .FirstOrDefault(m => m.ModCode == modCode);

            return module != null
                && module.Level == level
                && module.Trimester == trimester;
        }) ?? 0;

        int planned = TempSelectedModules.Count(code =>
        {
            var module = Year1Modules
                .Concat(Year2Modules)
                .Concat(Year3Modules)
                .FirstOrDefault(m => m.ModCode == code);

            return module != null
                && module.Level == level
                && module.Trimester == trimester;
        });

        return enrolled + planned;
    }

    private bool IsYearLongModule(ModuleData module)
    {
        return module.SelectionStatus == "Core" || module.SelectionStatus == "Elective";
    }

    private bool HasSelectedYearLongModule(string level)
    {
        return TempSelectedModules.Any(code =>
        {
            var module = Year1Modules
                .Concat(Year2Modules)
                .Concat(Year3Modules)
                .FirstOrDefault(m => m.ModCode == code);

            return module != null
                && module.Level == level
                && IsYearLongModule(module);
        });
    }

    private void ToggleTempEnrollment(ModuleData module)
    {
        var level = module.Level;
        var trimester = module.Trimester;

        if (TempSelectedModules.Contains(module.ModCode))
        {
            TempSelectedModules.Remove(module.ModCode);
            return;
        }

        // Year-long rule (Core OR Elective)
        if (IsYearLongModule(module) && HasSelectedYearLongModule(level))
            return;

        // Trimester rule (max 2)
        var current = CountTotalSelectionsForTrimester(level, trimester);
        if (current >= 2)
            return;

        TempSelectedModules.Add(module.ModCode);
    }

    private bool CanShowToggle(ModuleData module)
    {
        if (IsStudentEnrolledInModule(module))
            return false;

        if (IsModuleRestricted(module))
            return false;

        var level = module.Level;
        var trimester = module.Trimester;

        // Always allow removing
        if (TempSelectedModules.Contains(module.ModCode))
            return true;

        // Year-long rule
        if (IsYearLongModule(module) && HasSelectedYearLongModule(level))
            return false;

        // Trimester rule
        var current = CountTotalSelectionsForTrimester(level, trimester);
        return current < 2;
    }

    private double CalculateModuleGrade(ModuleData module)
    {
        if (module == null || student == null)
            return 0;

        var course = student.Courses
            .FirstOrDefault(c =>
                GetModuleFromCourse(c)?.ModCode == module.ModCode);

        if (course == null)
            return 0;

        double total = 0;
        double totalWeight = 0;

        foreach (var assignment in course.Assignments)
        {
            double? score = null;

            // 1. real submission
            var submission = assignment.Submissions
                .FirstOrDefault(s => s.StudentId == student.StudentId);

            if (submission?.Score != null)
            {
                score = submission.Score.Value;
            }
            // 2. planned fallback
            else if (PlannedAssignmentScores.TryGetValue(assignment.Id, out var planned))
            {
                score = planned;
            }

            if (score == null)
                continue;

            var weight = assignment.Weighting ?? 0;

            total += score.Value * weight;
            totalWeight += weight;
        }

        return totalWeight == 0 ? 0 : total / totalWeight;
    }

    private double? GetRealSubmissionScore(long assignmentId)
    {
        return student?.Courses
            .SelectMany(c => c.Assignments)
            .SelectMany(a => a.Submissions)
            .FirstOrDefault(s =>
                s.AssignmentId == assignmentId &&
                s.StudentId == student.StudentId)
            ?.Score;
    }

    private double? GetPlannedScore(string modCode, long assignmentId)
    {
        if (PlannedModules.TryGetValue(modCode, out var module))
        {
            if (module.AssignmentScores.TryGetValue(assignmentId, out var score))
                return score;
        }
        return null;
    }

    private async Task SetPlannedScore(string modCode, long assignmentId, object? value)
    {
        if (!double.TryParse(value?.ToString(), out var score))
            return;

        if (!PlannedModules.ContainsKey(modCode))
        {
            PlannedModules[modCode] = new PlannedModuleGrade
            {
                ModCode = modCode
            };
        }

        PlannedModules[modCode].AssignmentScores[assignmentId] = score;

        // 🔥 recompute grade live
        if (ActiveModule != null)
        {
            ProjectedGrade = await CalculateOverallGrade(ActiveModule);
            StateHasChanged();
        }
    }

    private async Task<double> CalculateOverallGrade(ModuleData module)
    {
        var assignments = await GetAssignmentsForModule(module);

        double total = 0;
        double totalWeight = 0;

        foreach (var assignment in assignments)
        {
            double? score = null;

            // 1. real submission
            var real = GetRealSubmissionScore(assignment.Id);
            if (real != null)
            {
                score = real;
            }
            // 2. planned fallback
            else
            {
                score = GetPlannedScore(module.ModCode, assignment.Id);
            }

            if (score == null)
                continue;

            var weight = assignment.Weighting ?? 0;

            total += score.Value * weight;
            totalWeight += weight;
        }

        return totalWeight > 0 ? total / totalWeight : 0;
    }


    private ModuleData? GetModuleFromCourse(Course course)
    {
        if (course == null || string.IsNullOrWhiteSpace(course.Code))
            return null;

        var modCode = ExtractModCodeFromCourse(course.Code);

        return Year1Modules
            .Concat(Year2Modules)
            .Concat(Year3Modules)
            .FirstOrDefault(m => m.ModCode == modCode);
    }

    private double GetAssignmentProjectedScore(long assignmentId)
    {
        var submission = student?.Courses
            .SelectMany(c => c.Assignments)
            .SelectMany(a => a.Submissions)
            .FirstOrDefault(s => s.StudentId == student.StudentId && s.AssignmentId == assignmentId);

        if (submission?.Score != null)
            return submission.Score.Value;

        return PlannedAssignmentScores.TryGetValue(assignmentId, out var planned)
            ? planned
            : 0;
    }

    private double GetPlannedScore(long assignmentId)
    {
        return PlannedAssignmentScores.TryGetValue(assignmentId, out var value)
            ? value
            : 0;
    }

    private void SetPlannedScore(long assignmentId, object? value)
    {
        if (value == null)
            return;

        if (double.TryParse(value.ToString(), out var score))
        {
            PlannedAssignmentScores[assignmentId] = score;
        }
    }

    private List<Assignment> GetAllAssignmentsForModule()
    {
        if (student == null || ActiveModule == null)
            return new List<Assignment>();

        var modCode = ActiveModule.ModCode;

        // Find matching courses for this module
        var matchingCourses = student.Courses
            .Where(c => ExtractModCodeFromCourse(c.Code) == modCode)
            .ToList();

        // Get ALL assignments from those courses
        return matchingCourses
            .SelectMany(c => c.Assignments)
            .ToList();
    }

    private void OnPlannedGradeChanged(long assignmentId, object? value)
    {
        if (double.TryParse(value?.ToString(), out var grade))
        {
            PlannedGrades[assignmentId] = grade;
        }
    }

    private async Task<List<Assignment>> GetAssignmentsForModule(ModuleData module)
    {
        if (student != null && IsStudentEnrolledInModule(module))
        {
            return student.Courses
                .Where(c => ExtractModCodeFromCourse(c.Code) == module.ModCode)
                .SelectMany(c => c.Assignments)
                .ToList();
        }

        // Planned module → fetch from backend
        return await service.GetAssignmentsByModuleCodeAsync(module.ModCode);
    }

