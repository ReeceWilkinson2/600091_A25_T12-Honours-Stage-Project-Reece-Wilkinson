@code {
	CompetencyCreationForm form = new CompetencyCreationForm();
	int idContent;

	List<CompetencyData> CompetencyDatas = new List<CompetencyData>();

	protected override async Task OnInitializedAsync()
	{
		await RefreshCompetencyData();
	}

	private async Task RefreshCompetencyData()
	{
		CompetencyDatas = await service.GetCompetencyDataAsync();
	}

	public CompetencyData NewCompetency { get; set; } = new CompetencyData();

	private async Task AddNewCompetencyData()
	{
		await service.AddCompetencyDataAsync(NewCompetency);
		NewCompetency = new CompetencyData();
		await RefreshCompetencyData();
	}
}