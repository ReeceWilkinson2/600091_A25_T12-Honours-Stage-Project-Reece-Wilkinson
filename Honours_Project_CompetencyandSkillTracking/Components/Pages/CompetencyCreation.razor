@page "/competencycreation"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject ICompetencyDataServices service
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject AppDbContext dbContext

<div style="margin-bottom:10px">
    <button class="module-button" @onclick="ReturnToSelection">
        ← Back to Selection
    </button>
</div>

<h3>Add New Competency</h3>

<EditForm Model="@NewCompetency" OnValidSubmit="AddNewCompetencyData">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label>Competency Name</label>
        <InputText @bind-Value="NewCompetency.CompetencyName" class="form-control" />
    </div>

    <div class="form-group">
        <label>Competency ID</label>
        <InputText @bind-Value="NewCompetency.CompetencyCode" class="form-control" />
    </div>

    <div class="form-group">
        <label>Additional Notes</label>
        <InputTextArea @bind-Value="NewCompetency.AdditionalNotes" class="form-control" />
    </div>

    <h4 class="mt-4">Competency Levels</h4>

    @foreach (var level in NewLevels)
    {
        <div class="form-group border p-3 mb-3">

            <label>Level Number</label>
            <InputNumber @bind-Value="level.LevelNumber" class="form-control" />

            <label>Description</label>
            <InputTextArea @bind-Value="level.Description" class="form-control" />

            <label>Module</label>
            <select class="form-control"value="@level.ModCode"@onchange="(e) => HandleModuleChange(e, level)">
                <option value="">Select Module</option>

                @foreach (var module in DistinctModules)
                {
                    <option value="@module.ModCode">
                        @module.ModuleName (@module.ModCode)
                    </option>
                }
            </select>

            <button type="button"class="btn btn-danger mt-2"@onclick="() => RemoveLevel(level)">
                Remove Level
            </button>

        </div>
    }

    <button type="button"class="btn btn-secondary mb-3"@onclick="AddLevel">
        + Add Level
    </button>

    <button type="submit"  class="btn btn-primary">
        Add Competency
    </button>
</EditForm>

@code {

    public CompetencyData NewCompetency { get; set; } = new();

    private List<CompetencyLevels> NewLevels = new();

    private List<ModuleData> AllModules = new();
    private List<ModuleData> DistinctModules = new();

    protected override async Task OnInitializedAsync()
    {
        AllModules = await dbContext.ModulesCSV.ToListAsync();

        // Remove duplicates using ModCode
        DistinctModules = AllModules
            .GroupBy(m => m.ModCode)
            .Select(g => g.First())
            .OrderBy(m => m.ModuleName)
            .ToList();
    }

    private void AddLevel()
    {
        NewLevels.Add(new CompetencyLevels
        {
            LevelNumber = NewLevels.Count > 0
                ? NewLevels.Max(l => l.LevelNumber) + 1
                : 4
        });
    }

    private void RemoveLevel(CompetencyLevels level)
    {
        NewLevels.Remove(level);
    }

    private void HandleModuleChange(ChangeEventArgs e, CompetencyLevels level)
    {
        level.ModCode = e.Value?.ToString();
    }

    private async Task AddNewCompetencyData()
    {
        // Attach levels to competency
        NewCompetency.Levels = NewLevels;

        await service.AddCompetencyDataAsync(NewCompetency);

        // Reset form
        NewCompetency = new CompetencyData();
        NewLevels = new List<CompetencyLevels>();
    }

    private void ReturnToSelection()
    {
        NavigationManager.NavigateTo("/datacreation");
    }
}