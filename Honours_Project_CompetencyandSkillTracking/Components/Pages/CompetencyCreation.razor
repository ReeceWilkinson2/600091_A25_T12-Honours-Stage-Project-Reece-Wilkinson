@page "/competencycreation"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CompetencyDataServices service
@inject Blazored.LocalStorage.ILocalStorageService localStorage
@inject AppDbContext dbContext

<h3>Add New Competency</h3>

<EditForm Model="@NewCompetency" OnValidSubmit="AddNewCompetencyData">
    <DataAnnotationsValidator />
    <ValidationSummary />

    <div class="form-group">
        <label for="CompetencyName">Competency Name</label>
        <InputText id="CompetencyName" @bind-Value="NewCompetency.CompetencyName" class="form-control" />
    </div>

    <div class="form-group">
        <label for="CompetencyID">Competency ID</label>
        <InputText id="CompetencyID" @bind-Value="NewCompetency.CompetencyID" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Module">Module</label>
        <select id="Module" class="form-control" value="@SelectedModuleId" @onchange="HandleModuleChange">
            <option value="">Select Module</option>
            @foreach (var module in Modules)
            {
                <option value="@module.DatabaseID">
                    @module.ModuleName - @module.Title
                </option>
            }
        </select>
    </div>

    <div class="form-group">
        <label for="Course">Course</label>
        <InputText id="Course" @bind-Value="NewCompetency.Course" class="form-control" disabled />
    </div>

    <div class="form-group">
        <label for="Level4Description">Level 4 Description</label>
        <InputText id="Level4Description" @bind-Value="NewCompetency.Level4Description" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Level5Description">Level 5 Description</label>
        <InputText id="Level5Description" @bind-Value="NewCompetency.Level5Description" class="form-control" />
    </div>

    <div class="form-group">
        <label for="Level6Description">Level 6 Description</label>
        <InputText id="Level6Description" @bind-Value="NewCompetency.Level6Description" class="form-control" />
    </div>

    <div class="form-group">
        <label for="AdditionalNotes">Additional Notes</label>
        <InputText id="AdditionalNotes" @bind-Value="NewCompetency.AdditionalNotes" class="form-control" />
    </div>

    <button type="submit" class="btn btn-primary">Add Competency</button>
</EditForm>

@code {
    public CompetencyData NewCompetency { get; set; } = new CompetencyData();
    private List<ModuleData> Modules { get; set; } = new List<ModuleData>();
    private int? SelectedModuleId;


    protected override async Task OnInitializedAsync()
    {
        Modules = await dbContext.ModulesCSV.ToListAsync();
    }

    private void HandleModuleChange(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var id))
        {
            SelectedModuleId = id;
            var selectedModule = Modules
                .FirstOrDefault(m => m.DatabaseID == id);
            if (selectedModule != null)
            {
                NewCompetency.Module = selectedModule.ModuleName;
                NewCompetency.Course = selectedModule.Title;
            }
        }
        else
        {
            NewCompetency.Module = string.Empty;
            NewCompetency.Course = string.Empty;
            SelectedModuleId = null;
        }
    }

    private async Task AddNewCompetencyData()
    {
        if (string.IsNullOrEmpty(NewCompetency.Module))
        {
            return;
        }
        await service.AddCompetencyDataAsync(NewCompetency);
        NewCompetency = new CompetencyData();
    }
}