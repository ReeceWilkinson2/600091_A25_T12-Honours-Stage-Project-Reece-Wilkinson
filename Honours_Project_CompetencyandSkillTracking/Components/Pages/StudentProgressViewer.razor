@page "/studentprogressviewer"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthStateService AuthState
@inject AppDbContext DbContext

<h3>Competency Progress</h3>

@if (!achievements.Any())
{
    <p>No competency data available yet.</p>
}
else
{
    <canvas id="competencyChart" width="600" height="400"></canvas>
}
<p>@achievements.Count data points loaded</p>

@code {
    private List<CompetencyAchievement> achievements = new();
    private string[] labels = Array.Empty<string>();
    private int[] data = Array.Empty<int>();

    protected override async Task OnInitializedAsync()
    {
        // Initialize AuthStateService to get the current user details
        await AuthState.InitializeAsync();

        // Check if the user is authenticated (UserId is available)
        if (AuthState.UserId != null)
        {
            // Filter competency achievements based on the logged-in user's UserId
            achievements = await DbContext.CompetencyAchievements
                .Where(a => a.StudentId == AuthState.UserId)  // Filter by UserId
                .Include(a => a.CompetencyLevel)
                .OrderBy(a => a.AchievedDate)
                .ToListAsync();

            // Prepare the labels and data
            labels = achievements.Select(a => a.AchievedDate.ToString("yyyy-MM-dd")).ToArray();
            data = achievements.Select(a => a.CompetencyLevel.LevelNumber).ToArray();
        }
        else
        {
            // Handle the case where there is no authenticated user
            achievements.Clear();
        }
    }

    private bool chartRendered = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartRendered && achievements.Any())
        {
            chartRendered = true;

            await JS.InvokeVoidAsync(
                "renderLineChart",
                "competencyChart",
                labels,
                data
            );
        }
    }
}