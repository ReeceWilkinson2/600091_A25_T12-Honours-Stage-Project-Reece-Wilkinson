@page "/studentprogressviewer"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject AuthStateService AuthState
@inject CompetencyDataServices CompetencyDataServices
@inject AppDbContext DbContext
@using Microsoft.AspNetCore.WebUtilities
@using Microsoft.EntityFrameworkCore

<div style="margin-bottom:20px">
    <button class="module-button" @onclick="GoToStudentJourney">Go back to student journey</button>
</div>

<h3>Competency Progress: @CompetencyName</h3>

@if (!achievements.Any())
{
    <p>No competency achievements found.</p>
}
else
{
    <canvas id="competencyChart" width="75%" height="50%"></canvas>

    <div style="margin-top: 20px; width: 75%;">
        <div style="
            height: 15px;
            width: 100%;
            background: linear-gradient(to right, rgb(0, 238, 255), rgb(0, 0, 255));
            border-radius: 5px;">
        </div>

        <div style="display: flex; justify-content: space-between; font-size: 12px; margin-top: 5px;">
            <span>1</span>
            <span>2</span>
            <span>3</span>
            <span>4</span>
            <span>5</span>
            <span>6</span>
        </div>

        <div style="text-align: center; font-size: 13px; margin-top: 5px;">
            Number of times competency level achieved
        </div>
    </div>

    <div>
        <h4>Competency Levels:</h4>
        <ul>
            @foreach (var level in competencyLevels)
            {
                var matchingAchievements = achievements.Where(a => a.CompetencyLevelId == level.LevelDbID);

                <li>
                    <strong>Level @level.LevelNumber:</strong>
                    <p>@level.Description</p>

                    <div>
                        <strong>Modules covered in:</strong>

                        @if (level.Modules != null && level.Modules.Any())
                        {
                            <ul style="padding-left:0; margin:0;">
                                @foreach (var module in level.Modules)
                                {
                                    <li>@module.ModCode - @module.ModuleName</li>
                                }
                            </ul>
                        }
                        else
                        {
                            <span>Not Assigned</span>
                        }
                    </div>

                    <div style="margin-top:5px;">
                        @if (matchingAchievements.Any())
                        {
                            <ul>
                                @foreach (var ach in matchingAchievements)
                                {
                                    <li>
                                        @ach.AchievedDate.ToShortDateString() |
                                        Mastery Points: @ach.MasteryPoints
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <p>No achievements yet</p>
                        }
                    </div>
                </li>
            }

            <li>
                <strong>Additional Notes:</strong>
                <p>@AdditionalNotes</p>
            </li>
        </ul>
    </div>
}

@code {
    private List<CompetencyAchievement> achievements = new();
    private List<object> chartPoints = new();
    private string[][] moduleTooltips = Array.Empty<string[]>();
    private int[] levelCounts = Array.Empty<int>();

    private string competencyId = "";
    private string CompetencyName = string.Empty;
    private string AdditionalNotes = string.Empty;
    private List<CompetencyLevels> competencyLevels = new();

    private bool chartRendered = false;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        var queryParams = QueryHelpers.ParseQuery(NavigationManager.ToAbsoluteUri(NavigationManager.Uri).Query);
        competencyId = queryParams.ContainsKey("competencyId")
            ? queryParams["competencyId"].ToString()
            : string.Empty;

        if (AuthState.UserId != null && !string.IsNullOrEmpty(competencyId))
        {
            achievements = await DbContext.CompetencyAchievements
                .Where(a => a.StudentId == AuthState.UserId &&
                            a.CompetencyLevel.Competency.CompetencyID == competencyId)
                .Include(a => a.CompetencyLevel)
                    .ThenInclude(cl => cl.Competency)
                .Include(a => a.CompetencyLevel)
                    .ThenInclude(cl => cl.Modules)
                .Include(a => a.Module)
                .OrderBy(a => a.AchievedDate)
                .ToListAsync();

            var competency = await CompetencyDataServices.GetCompetencyByIdAsync(competencyId);
            CompetencyName = competency?.CompetencyName ?? string.Empty;

            competencyLevels = competency?.Levels
                .Where(l => l.LevelNumber >= 4 && l.LevelNumber <= 7)
                .OrderBy(l => l.LevelNumber)
                .ToList() ?? new List<CompetencyLevels>();

            var levelGroups = achievements
                .GroupBy(a => a.CompetencyLevel)
                .Where(g => g.Key.LevelNumber >= 4 && g.Key.LevelNumber <= 7)
                .OrderBy(g => g.Key.LevelNumber)
                .ToList();

            chartPoints = levelGroups
                .Select(g => new
                {
                    x = g.Min(a => a.AchievedDate), // first achieved date
                    y = g.Key.LevelNumber
                })
                .ToList<object>();

            moduleTooltips = levelGroups
                .Select(g => g.Select(a => $"{a.Module.ModCode} - {a.Module.ModuleName}").ToArray())
                .ToArray();

            levelCounts = levelGroups
                .Select(g => Math.Min(g.Count(), 6))
                .ToArray();
        }
        else
        {
            achievements.Clear();
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!chartRendered && chartPoints.Any())
        {
            chartRendered = true;

            var labels = chartPoints
                .Select(p => ((DateTime)((dynamic)p).x).ToString("MMM dd, yyyy"))
                .ToArray();

            var yValues = chartPoints.Select(p => ((dynamic)p).y).ToArray();

            await JS.InvokeVoidAsync(
                "renderLineChart",
                "competencyChart",
                labels,
                yValues,
                moduleTooltips,
                levelCounts
            );
        }
    }

    private void GoToStudentJourney()
    {
        NavigationManager.NavigateTo("/studentjourney");
    }
}