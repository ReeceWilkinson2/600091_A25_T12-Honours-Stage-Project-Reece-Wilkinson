@page "/PasswordReset"
@inject NavigationManager NavigationManager
@inject UserDataServices service
@rendermode InteractiveServer
@layout LoggedOutLayout
@using System.Net.Mail
@using Honours_Project_CompetencyandSkillTracking.Components.Layout
@using Honours_Project_CompetencyandSkillTracking.Data
@using Honours_Project_CompetencyandSkillTracking.Classes

<style>
	body {
		background: url("/Images/background-img.jpg") no-repeat;
		background-size: cover;
		background-position: center;
	}
</style>

<div class="body">
	<div class="form-body">
		<div class="form-wrapper">
			<h1> Reset Password</h1>
			<EditForm Model="@form" OnValidSubmit="SendEmail">
				<div class="input-box">
					<InputText class="input" type="email" id="email" placeholder="Email" @bind-Value="form.Email"></InputText>
					<i class='bx bxs-envelope'></i>
				</div>
				<p>If the E-Mail is valid, a message will arrive shortly with a temporary password</p>
				<span>@Message</span>
				<button type="submit">Reset Password</button>
			</EditForm>
		</div>
	</div>
</div>

@code {
	private string Message { get; set; }
	ResetPasswordForm form = new ResetPasswordForm();
	List<UserData> UsersData = new List<UserData>();

	UserData UpdateUserData = new UserData();

	protected override async Task OnInitializedAsync()
	{
		await RefreshUserData();
	}

	private void SetUserDataForUpdate(UserData userData)
	{
		UpdateUserData = userData;
	}

	private async Task RefreshUserData()
	{
		UsersData = await service.GetUserDataAsync();
	}

	private async Task UpdateUserDataData()
	{
		await service.UpdateUserDataAsync(UpdateUserData);
		await RefreshUserData();
	}



	public void SendEmail(EditContext context)
	{
		foreach (var user in UsersData)
		{
			if (user.UserEmail == form.Email)
			{
				SetUserDataForUpdate(user);
				UpdateUserData.UserPassword = GenerateTempPassword();
				_ = UpdateUserDataData();
				_ = RefreshUserData();

				try
				{
					using (MailMessage mail = new MailMessage())
					{
						mail.From = new MailAddress("dormify.liveitup@gmail.com");
						mail.To.Add(form.Email);
						mail.Subject = "Reset your LiveItUp Password";
						mail.Body = $"<h1>Your new Temporary Password</h1> <p> Your new temporary password for your LiveItUp account is: <b>{UpdateUserData.UserPassword}</b>. Do not share this with anyone.</p>";
						mail.IsBodyHtml = true;

						using (SmtpClient smtp = new SmtpClient("smtp.gmail.com", 587))
						{
							smtp.Credentials = new System.Net.NetworkCredential("dormify.liveitup@gmail.com", "eblqwqcadbabwdvp");
							smtp.EnableSsl = true;
							smtp.Send(mail);
							Message = "Mail sent";
						}
					}
				}
				catch (Exception ex)
				{
					Message = ex.Message;
				}

			}
		}

	}

	public string GenerateTempPassword()
	{
		var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
		var stringChars = new char[8];
		var random = new Random();

		for (int i = 0; i < stringChars.Length; i++)
		{
			stringChars[i] = chars[random.Next(chars.Length)];
		}

		var finalString = new String(stringChars);
		return finalString;
	}




}