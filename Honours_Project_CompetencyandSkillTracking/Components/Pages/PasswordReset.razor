@page "/PasswordReset"
@inject NavigationManager NavigationManager
@inject UserService UserService
@rendermode InteractiveServer
@layout LoggedOutLayout
@inject IOptions<SmtpConfig> SmtpConfig
@using System.Net
@using System.Net.Mail
@using Microsoft.Extensions.Options

<style>
	body {
		background: url("Images/myhc_373562.png") no-repeat;
		background-size: cover;
		background-position: center;
	}

	::-ms-reveal {
		filter: invert(100%);
	}
</style>

<div class="body">
	<div class="form-body">
		<div class="form-wrapper">
			<h1> Reset Password</h1>
			<EditForm Model="@form" OnValidSubmit="SendEmail">
				<div class="input-box">
					<InputText class="input" type="email" id="email" placeholder="Email" @bind-Value="form.Email"></InputText>
					<i class='bx bxs-envelope'></i>
				</div>
				<p>If the E-Mail is valid, a message will arrive shortly with a temporary password</p>
				<span>@Message</span>
				<button type="submit">Reset Password</button>
			</EditForm>
		</div>
	</div>
</div>

@code {
	private string Message { get; set; } = "";
	ResetPasswordForm form = new ResetPasswordForm();

	private async Task SendEmail(EditContext context)
	{
		// Look up user in Students table
		var user = await UserService.GetUserByEmailAsync(form.Email);

		if (user == null)
		{
			Message = "If the email exists, a reset message will be sent.";
			return;
		}

		// Generate temporary password
		string tempPassword = GenerateTempPassword();

		// Update user password in DB
		user.Password = tempPassword;
		await UserService.UpdateUserAsync(user);

		// Send email
		var smtp = SmtpConfig.Value;

		try
		{
			using var mail = new MailMessage();
			mail.From = new MailAddress(smtp.Email);
			mail.To.Add(form.Email);
			mail.Subject = "Reset your Password";
			mail.Body = $"<h1>Your new Temporary Password</h1>" +
						$"<p>Your new temporary password for your LiveItUp account is: <b>{tempPassword}</b>. " +
						"Do not share this with anyone.</p>";
			mail.IsBodyHtml = true;

			using var client = new SmtpClient(smtp.Host, smtp.Port);
			client.Credentials = new NetworkCredential(smtp.Email, smtp.Password);
			client.EnableSsl = true;

			client.Send(mail);

			Message = "If the email exists, a reset message will be sent.";
		}
		catch (Exception ex)
		{
			Message = $"Error sending email: {ex.Message}";
		}
	}

	public string GenerateTempPassword()
	{
		var chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
		var stringChars = new char[8];
		var random = new Random();

		for (int i = 0; i < stringChars.Length; i++)
		{
			stringChars[i] = chars[random.Next(chars.Length)];
		}

		return new string(stringChars);
	}
}