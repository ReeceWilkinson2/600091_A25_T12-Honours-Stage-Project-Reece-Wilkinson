@page "/index"
@using Honours_Project_CompetencyandSkillTracking.Data
@inject UserDataServices service
@rendermode InteractiveServer

<div class="container">

    <div class="row bg-light">
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>ID</th>
                    <th>Username</th>
                    <th>Email</th>
                    <th>Theme</th>
                    <th>UserRole</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (UsersData.Any())
                {
                    @foreach (var userData in UsersData)
                    {
                        <tr @onclick="(() => SetUserDataForUpdate(userData))">
                            <td>@userData.UserId</td>
                            <td>@userData.UserUsername</td>
                            <td>@userData.UserEmail</td>
                            <td>@userData.UserTheme</td>
                            <td>@userData.UserRole</td>
                            <td><button class="btn btn-danger" @onclick="(() => DeleteUserData(userData))">Delete</button></td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6"><strong>No user data available</strong></td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row m-5">
        <div class="col-5 bg-light m-2 justify-content-start">

            <div class="p-3 mb-3 bg-primary text-white text-center">Add New User Data</div>

            <EditForm Model="@NewUserData">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" class="form-control" @bind-value="@NewUserData.UserUsername" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="text" id="email" class="form-control" @bind="@NewUserData.UserEmail" />
                </div>

                <div class="form-group">
                    <label for="Theme">Theme</label>
                    <input type="text" id="theme" class="form-control" @bind="@NewUserData.UserTheme" />
                </div>

                <div class="form-group">
                    <label for="UserRole">UserRole</label>
                    <input type="text" id="userrole" class="form-control" @bind="@NewUserData.UserRole" />
                </div>

                <div class="text-center p-3 mb-3">
                    <button class="btn btn-info" @onclick="AddNewUserData"> Add User Data</button>
                </div>
            </EditForm>
        </div>

        <div class="col-5 bg-light m-2 justify-content-end">
            <div class="p-3 mb-1 bg-primary text-white text-center">Update User Data</div>

            <EditForm Model="@UpdateUserData">
                <div class="form-group">
                    <label for="username">Username</label>
                    <input type="text" id="username" class="form-control" @bind-value="@UpdateUserData.UserUsername" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="text" id="email" class="form-control" @bind="@UpdateUserData.UserEmail" />
                </div>

                <div class="form-group">
                    <label for="theme">Theme</label>
                    <input type="text" id="theme" class="form-control" @bind-value="@UpdateUserData.UserTheme" />
                </div>

                <div class="form-group">
                    <label for="UserRole">User Role</label>
                    <input type="text" id="userrole" class="form-control" @bind="@UpdateUserData.UserRole" />
                </div>

                <div class="text-center p-3 mb-3">
                    <button class="btn btn-info" @onclick="UpdateUserDataData">Update User Data</button>
                </div>
            </EditForm>
        </div>
    </div>


</div>

@code {

    List<UserData> UsersData = new List<UserData>();

    protected override async Task OnInitializedAsync()
    {
        await RefreshUserData();
    }

    private async Task RefreshUserData()
    {
        UsersData = await service.GetUserDataAsync();
    }


    public UserData NewUserData { get; set; } = new UserData();

    private async Task AddNewUserData()
    {
        await service.AddUserDataAsync(NewUserData);
        NewUserData = new UserData();
        await RefreshUserData();
    }

    UserData UpdateUserData = new UserData();
    private void SetUserDataForUpdate(UserData userData)
    {
        UpdateUserData = userData;
    }

    private async Task UpdateUserDataData()
    {
        await service.UpdateUserDataAsync(UpdateUserData);
        await RefreshUserData();
    }

    private async Task DeleteUserData(UserData userData)
    {
        await service.DeleteUserDataAsync(userData);
        await RefreshUserData();
    }
}