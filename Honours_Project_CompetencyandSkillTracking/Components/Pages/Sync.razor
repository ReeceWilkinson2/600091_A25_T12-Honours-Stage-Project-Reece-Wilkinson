@page "/sync"
@rendermode InteractiveServer
@using Honours_Project_CompetencyandSkillTracking.Canvas
@using Honours_Project_CompetencyandSkillTracking.Components.Services
@inject CanvasSyncService CanvasSyncService
@inject ModuleCSVReading ModuleCSVReading

<h3>Canvas Sync</h3>

@if (_isSyncing)
{
    <p>Syncing Canvas data… please wait.</p>
}
else if (_isCsvReading)
{
    <p>Reading CSV file… please wait.</p>
}
else if (_error != null)
{
    <p style="color:red">Error: @_error</p>
}
else if (_completed)
{
    <p style="color:green">Data sync completed successfully.</p>
}

<button @onclick="StartSync" disabled="@_isSyncing">
    Start Sync
</button>

<button @onclick="ReadCsv" >
    Import Modules from CSV
</button>

@code {
    private bool _isSyncing;
    private bool _isCsvReading;
    private bool _completed;
    private string? _error;

    private async Task StartSync()
    {
        Console.WriteLine(">>> StartSync clicked");

        _isSyncing = true;
        _completed = false;
        _error = null;

        try
        {
            await CanvasSyncService.SyncAllAsync();
            _completed = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSyncing = false;
        }
    }

    private async Task ReadCsv()
    {
        Console.WriteLine(">>> ReadCsv clicked");

        _isCsvReading = true;
        _completed = false;
        _error = null;

        try
        {
            var reader = new ModuleCSVReading();
            var modules = reader.ReadModules();

            Console.WriteLine($"Loaded {modules.Count} modules from CSV.");

            // TODO: Save to database if needed

            _completed = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isCsvReading = false;
        }
    }
}
