@page "/competencyselection"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CompetencyDataServices service

<h3>Competency Catalogue</h3>
<p>Please select a competency to view:</p>

<div>
	@foreach (var competency in Competencies)
	{
		<button class="module-button" style="width: 100%; text-align: left; margin-bottom: 10px" @onclick ="() => LoadCompetencyDetails(competency)">@competency.CompetencyCode, @competency.CompetencyName</button>
	}
</div>

@code {
	private List<CompetencyData> Competencies = new List<CompetencyData>();

	protected override async Task OnInitializedAsync()
	{
		Competencies = await service.GetCompetencyDataAsync();
	}

	private void LoadCompetencyDetails(CompetencyData competency)
	{
		NavigationManager.NavigateTo($"/competencyviewer/{competency.CompetencyCode}");
	}
}