@page "/competencyselection"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CompetencyDataServices service

<div>
	@foreach (var competency in Competencies)
	{
		<button class="module-button" @onclick="() => LoadCompetencyDetails(competency)">@competency.CompetencyID, @competency.CompetencyName</button>
	}
</div>

@code {
	private List<CompetencyData> Competencies = new List<CompetencyData>();

	protected override async Task OnInitializedAsync()
	{
		Competencies = await service.GetCompetencyDataAsync();
	}

	private void LoadCompetencyDetails(CompetencyData competency)
	{
		NavigationManager.NavigateTo($"/competencyviewer/{competency.CompetencyID}");
	}
}