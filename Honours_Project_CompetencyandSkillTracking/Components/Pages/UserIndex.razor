@page "/userindex"
@using Microsoft.EntityFrameworkCore; 
@using Honours_Project_CompetencyandSkillTracking.Data
@using Honours_Project_CompetencyandSkillTracking.Canvas
@inject UserService service
@inject AppDbContext DbContext
@rendermode InteractiveServer

<div class="container">

    <div class="row bg-light mb-4">
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Student ID</th>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Students.Any())
                {
                    @foreach (var student in Students)
                    {
                        <tr @onclick="(() => SetStudentForUpdate(student))">
                            <td>@student.StudentId</td>
                            <td>@student.UserName</td>
                            <td>@student.StEmail</td>
                            <td>@student.Password</td>
                            <td>@student.Role</td>
                            <td>
                                <button class="btn btn-danger"
                                        @onclick="() => DeleteStudent(student)"
                                        @onclick:stopPropagation="true">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="5" class="text-center"><strong>No students found</strong></td></tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row m-5">
        <div class="col-5 bg-light m-2">
            <div class="p-3 mb-3 bg-primary text-white text-center">Add New User</div>

            <EditForm Model="@NewStudent">
                <div class="form-group">
                    <label for="StudentID">ID</label>
                    <input type="text" id="StudentID" class="form-control" @bind-value="@NewStudent.StudentId" />
                </div>

                <div class="form-group">
                    <label for="username">Name</label>
                    <input type="text" id="username" class="form-control" @bind-value="@NewStudent.UserName" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="text" id="email" class="form-control" @bind-value="@NewStudent.StEmail" />
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" class="form-control" @bind="NewStudent.Role">
                        <option value="">Select Role</option>
                        <option value="Student">Student</option>
                        <option value="Staff">Staff</option>
                        <option value="Employer">Employer</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="text-center p-3 mb-3">
                    <button class="btn btn-info" @onclick="AddStudent">Add Student</button>
                </div>
            </EditForm>
        </div>

        <div class="col-5 bg-light m-2">
            <div class="p-3 mb-1 bg-primary text-white text-center">Update User</div>

            <EditForm Model="@UpdateStudent">
                <div class="form-group">
                    <label for="StudentID">ID</label>
                    <input type="text" id="StudentID" class="form-control" @bind-value="@UpdateStudent.StudentId" />
                </div>

                <div class="form-group">
                    <label for="username">Name</label>
                    <input type="text" id="username" class="form-control" @bind-value="@UpdateStudent.UserName" />
                </div>

                <div class="form-group">
                    <label for="email">Email</label>
                    <input type="text" id="email" class="form-control" @bind-value="@UpdateStudent.StEmail" />
                </div>

                <div class="form-group">
                    <label for="role">Role</label>
                    <select id="role" class="form-control" @bind="UpdateStudent.Role">
                        <option value="">Select Role</option>
                        <option value="Student">Student</option>
                        <option value="Staff">Staff</option>
                        <option value="Employer">Employer</option>
                        <option value="Admin">Admin</option>
                    </select>
                </div>

                <div class="text-center p-3 mb-3">
                    <button class="btn btn-info" @onclick="UpdateStudentData">Update User</button>
                </div>
            </EditForm>
        </div>
    </div>
</div>

@code {
    private List<User> Students = new();
    private User NewStudent = new User();
    private User UpdateStudent = new User();

    protected override async Task OnInitializedAsync()
    {
        await LoadStudents();
    }

    private async Task LoadStudents()
    {
        Students = await DbContext.Students.OrderBy(s => s.UserName).ToListAsync();
    }

    private async Task AddStudent()
    {
        if (string.IsNullOrEmpty(NewStudent.StudentId))
        {
            NewStudent.StudentId = Guid.NewGuid().ToString();
        }

        DbContext.Students.Add(NewStudent);
        await DbContext.SaveChangesAsync();

        NewStudent = new User();
        await LoadStudents();
    }

    private void SetStudentForUpdate(User student)
    {
        // Create a copy so UI edits don't immediately affect the list
        UpdateStudent = new User
        {
            StudentId = student.StudentId,
            UserName = student.UserName,
            StEmail = student.StEmail,
            Role = student.Role
        };
    }

    private async Task UpdateStudentData()
    {
        var student = await DbContext.Students.FindAsync(UpdateStudent.StudentId);
        if (student != null)
        {
            student.UserName = UpdateStudent.UserName;
            student.StEmail = UpdateStudent.StEmail;
            student.Role = UpdateStudent.Role;

            await DbContext.SaveChangesAsync();
            await LoadStudents();
        }
    }

    private async Task DeleteStudent(User student)
    {
        var s = await DbContext.Students.FindAsync(student.StudentId);
        if (s != null)
        {
            DbContext.Students.Remove(s);
            await DbContext.SaveChangesAsync();
            await LoadStudents();
        }
    }
}