@page "/signup"
@rendermode InteractiveServer
@layout LoggedOutLayout
@inject NavigationManager NavigationManager
@inject UserService UserService
@inject IOptions<SmtpConfig> SmtpConfig
@using System.Net
@using System.Net.Mail
@using Honours_Project_CompetencyandSkillTracking.Components.Layout
@using Honours_Project_CompetencyandSkillTracking.Components.Services
@using Honours_Project_CompetencyandSkillTracking.Data
@using Honours_Project_CompetencyandSkillTracking.Canvas
@using Honours_Project_CompetencyandSkillTracking.Classes
@using Microsoft.Extensions.Options

<style>

</style>

<div class="body">
	<div class="form-body">
		<div class="form-wrapper">
			<h1>Signup</h1>
			<p>Please fill out all details</p>
			<EditForm Model="@form" OnValidSubmit="SignupUser">
				<DataAnnotationsValidator></DataAnnotationsValidator>
				<ValidationSummary></ValidationSummary>
				<div class="input-box">
					<InputText class="input" id="fname" placeholder="First Name" @bind-Value="form.FirstName"></InputText>
				</div>
				<div class="input-box">
					<InputText class="input" id="lname" placeholder="Last Name" @bind-Value="form.LastName"></InputText>
				</div>
				<div class="input-box">
					<InputText class="input" id="email" placeholder="Email" @bind-Value="form.Email" type="email" />
					<ValidationMessage For="@(() => form.Email)" />
					<i class="bx bxs-envelope"></i>
				</div>
				<div class="input-box">
					<InputText class="input" id="password" placeholder="Password" @bind-Value="form.Password" type="password"></InputText>
					<i class="bx bxs-lock"></i>
				</div>
				<div class="role-select">
					<label for="role">Account Type: </label>
					<InputSelect class="select" id="role" @bind-value="form.Role">
						<option value="">(select one)</option>
						<option value="Student">Student</option>
						<option value="Staff">Staff</option>
						<option value="Staff">Employer</option>
					</InputSelect>
				</div>
				@if (form.Role == "staff")
				{
					<div class="input-box">
						<InputText class="input" id="staffPassword" placeholder="Enter Staff Password" @bind-Value="form.StaffPassword" type="password"></InputText>
					</div>
				}
				<div class="terms-and-conditions">
					<label><input type="checkbox" required id="terms"> I accept the terms and conditions</label>
				</div>
				<button type="submit">Sign Up</button>
			</EditForm>
			@if (!string.IsNullOrEmpty(errorMessage))
			{
				<div class="error-message">
					<p>@errorMessage</p>
				</div>
			}
		</div>
	</div>
</div>

@code {
	SignUpForm form = new SignUpForm();
	private string errorMessage = string.Empty;

	private async Task SignupUser()
	{
		// Staff password validation
		if (form.Role == "Staff" && form.StaffPassword != "secretpassword")
		{
			errorMessage = "The staff password is incorrect.";
			return;
		}

		// Prevent duplicate email signup
		var existingUser = await UserService.GetUserByEmailAsync(form.Email);
		if (existingUser != null)
		{
			errorMessage = "An account with that email already exists.";
			return;
		}

		// Create new record
		var newUser = new Student
		{
			StudentId = Guid.NewGuid().ToString(), // generate a new ID
			UserName = $"{form.FirstName} {form.LastName}",
			StEmail = form.Email,
			Password = BCrypt.Net.BCrypt.HashPassword(form.Password),
			Role = form.Role
		};

		await UserService.AddUserAsync(newUser);

		// Optional: send confirmation email (if you want)
		await SendEmail(form.Email);

		NavigationManager.NavigateTo("/");
	}

	private async Task SendEmail(string email)
	{
		var smtp = SmtpConfig.Value;

		try
		{
			using var mail = new MailMessage();
			mail.From = new MailAddress(smtp.Email);
			mail.To.Add(email);
			mail.Subject = "Account Created Successfully";
			mail.Body = "<h1>Your account has been created!</h1>";
			mail.IsBodyHtml = true;

			using var client = new SmtpClient(smtp.Host, smtp.Port);
			client.Credentials = new NetworkCredential(smtp.Email, smtp.Password);
			client.EnableSsl = true;

			await client.SendMailAsync(mail);
		}
		catch (Exception ex)
		{
			errorMessage = ex.Message;
		}
	}


