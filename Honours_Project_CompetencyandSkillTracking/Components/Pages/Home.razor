@page "/home"
@inject IAuthStateService AuthState
@inject NavigationManager NavigationManager
@inject IUserService UserService

@if (_authorized)
{
    <h1>Hello @_username,</h1>
    <p>Welcome to the Competency Tracking System</p>
    <p>Your role: @AuthState.Role</p>


    <button class="btn btn-secondary" @onclick="TogglePasswordForm">
        @(_showPasswordForm ? "Cancel" : "Change Password")
    </button>

    @if (_showPasswordForm)
    {
        <h3>Change Password</h3>
        <EditForm Model="_passwordModel" OnValidSubmit="HandlePasswordChange">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="form-group">
                <label for="oldPassword">Old Password</label>
                <InputText id="oldPassword" type="password" class="form-control" @bind-Value="_passwordModel.OldPassword" />
            </div>

            <div class="form-group">
                <label for="newPassword">New Password</label>
                <InputText id="newPassword" type="password" class="form-control" @bind-Value="_passwordModel.NewPassword" />
            </div>

            <div class="form-group">
                <label for="confirmPassword">Confirm New Password</label>
                <InputText id="confirmPassword" type="password" class="form-control" @bind-Value="_passwordModel.ConfirmPassword" />
            </div>

            <button type="submit" class="btn btn-primary">Submit</button>
        </EditForm>

        @if (_passwordChangeSuccess != null)
        {
            <p>@_passwordChangeSuccess</p>
        }
    }
}

@code {
    private bool _authorized = false;
    private string _username = "";
    private PasswordModel _passwordModel = new PasswordModel();
    private string? _passwordChangeSuccess = null;

    private bool _showPasswordForm = false;

    private void TogglePasswordForm()
    {
        _showPasswordForm = !_showPasswordForm;
        _passwordChangeSuccess = null; // optional: clear message when toggling
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrEmpty(AuthState.UserId))
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        var user = await UserService.GetUserByIdAsync(AuthState.UserId);

        if (user == null)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        _username = user.UserName;
        _authorized = true;
        StateHasChanged();
    }

    private async Task HandlePasswordChange()
    {
        if (_passwordModel.NewPassword != _passwordModel.ConfirmPassword)
        {
            _passwordChangeSuccess = "New password and confirmation do not match.";
            return;
        }

        bool success = await UserService.ChangePasswordAsync(
            AuthState.UserId,
            _passwordModel.OldPassword,
            _passwordModel.NewPassword
        );

        _passwordChangeSuccess = success
            ? "Password changed successfully!"
            : "Invalid old password.";
    }
}