@page "/home"
@inject AuthStateService AuthState
@inject NavigationManager NavigationManager
@inject UserService UserService

@if (_authorized)
{
    <h1>Hello, world!</h1>
    <p>Hello @_username</p>
    <p>Your role: @AuthState.Role</p>

    <h3>Change Password</h3>
    <EditForm Model="_passwordModel" OnValidSubmit="HandlePasswordChange">
        <DataAnnotationsValidator />
        <ValidationSummary />

        <div class="form-group">
            <label for="oldPassword">Old Password</label>
            <InputText id="oldPassword" class="form-control" @bind-Value="_passwordModel.OldPassword" />
        </div>

        <div class="form-group">
            <label for="newPassword">New Password</label>
            <InputText id="newPassword" class="form-control" @bind-Value="_passwordModel.NewPassword" />
        </div>

        <div class="form-group">
            <label for="confirmPassword">Confirm New Password</label>
            <InputText id="confirmPassword" class="form-control" @bind-Value="_passwordModel.ConfirmPassword" />
        </div>

        <button type="submit" class="btn btn-primary">Change Password</button>
    </EditForm>

    @if (_passwordChangeSuccess != null)
    {
        <p>@_passwordChangeSuccess</p>
    }
}

@code {
    private bool _authorized = false;
    private string _username = "";
    private PasswordModel _passwordModel = new PasswordModel();
    private string? _passwordChangeSuccess = null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (string.IsNullOrEmpty(AuthState.UserId))
        {
            NavigationManager.NavigateTo("/signin", true);
            return;
        }

        var user = await UserService.GetUserByIdAsync(AuthState.UserId);

        if (user == null)
        {
            NavigationManager.NavigateTo("/", true);
            return;
        }

        _username = user.UserName;
        _authorized = true;
        StateHasChanged();
    }

    private async Task HandlePasswordChange()
    {
        if (_passwordModel.NewPassword != _passwordModel.ConfirmPassword)
        {
            _passwordChangeSuccess = "New password and confirmation do not match.";
            return;
        }

        bool success = await UserService.ChangePasswordAsync(AuthState.UserId, _passwordModel.OldPassword, _passwordModel.NewPassword);

        if (success)
        {
            _passwordChangeSuccess = "Password changed successfully!";
        }
        else
        {
            _passwordChangeSuccess = "Invalid old password.";
        }
    }
}