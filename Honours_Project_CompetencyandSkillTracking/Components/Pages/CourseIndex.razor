@page "/courseindex"
@using Honours_Project_CompetencyandSkillTracking.Canvas.Classes
@inject AppDbContext DbContext
@rendermode InteractiveServer

<div class="container">

    <!-- COURSES TABLE -->
    <div class="row bg-light mb-4">
        <h4 class="p-2">Courses</h4>
        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Id</th>
                    <th>Name</th>
                    <th>Code</th>
                    <th>Term</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var course in Courses)
                {
                    <tr @onclick="() => SelectCourse(course)">
                        <td>@course.Id</td>
                        <td>@course.Name</td>
                        <td>@course.Code</td>
                        <td>@course.Term</td>
                        <td>
                            <button class="btn btn-danger"
                                    @onclick="() => DeleteCourse(course)"
                                    @onclick:stopPropagation="true">
                                Delete
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div class="row">
        <div class="col-5 bg-light m-2">
            <div class="p-3 bg-primary text-white text-center">Add / Update Course</div>

            <EditForm Model="@EditCourse">
                <div class="form-group">
                    <label>Name</label>
                    <input class="form-control" @bind="EditCourse.Name" />
                </div>

                <div class="form-group">
                    <label>Code</label>
                    <input class="form-control" @bind="EditCourse.Code" />
                </div>

                <div class="form-group">
                    <label>Term</label>
                    <input class="form-control" @bind="EditCourse.Term" />
                </div>

                <div class="text-center p-3">
                    <button class="btn btn-info" @onclick="SaveCourse">Save Course</button>
                </div>
            </EditForm>
        </div>

        <!-- ASSIGNMENTS -->
        <div class="col-6 bg-light m-2">
            <div class="p-3 bg-primary text-white text-center">
                Assignments (@SelectedCourse?.Name)
            </div>

            @if (SelectedCourse != null)
            {
                <table class="table table-bordered mt-2">
                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Due</th>
                            <th>Delete</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var a in Assignments)
                        {
                            <tr @onclick="() => SelectAssignment(a)">
                                <td>@a.Name</td>
                                <td>@a.DueAt</td>
                                <td>
                                    <button class="btn btn-danger"
                                            @onclick="() => DeleteAssignment(a)"
                                            @onclick:stopPropagation="true">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                <EditForm Model="@EditAssignment">
                    <div class="form-group">
                        <label>Name</label>
                        <input class="form-control" @bind="EditAssignment.Name" />
                    </div>

                    <div class="form-group">
                        <label>Description</label>
                        <textarea class="form-control" @bind="EditAssignment.Description"></textarea>
                    </div>

                    <div class="form-group">
                        <label>Due Date</label>
                        <input type="datetime-local" class="form-control"
                               @bind="EditAssignment.DueAt" />
                    </div>

                    <div class="text-center p-3">
                        <button class="btn btn-info" @onclick="SaveAssignment">
                            Save Assignment
                        </button>
                    </div>
                </EditForm>
            }
            else
            {
                <p class="p-3 text-center"><strong>Select a course</strong></p>
            }
        </div>
    </div>
</div>

@code {

    private List<Course> Courses = new();
    private List<Assignment> Assignments = new();

    private Course EditCourse = new();
    private Course? SelectedCourse;

    private Assignment EditAssignment = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        Courses = await DbContext.Courses
            .OrderBy(c => c.Name)
            .ToListAsync();
    }

    private async Task SelectCourse(Course course)
    {
        SelectedCourse = course;
        EditCourse = new Course
        {
            Id = course.Id,
            Name = course.Name,
            Code = course.Code,
            Term = course.Term
        };

        Assignments = await DbContext.Assignments
            .Where(a => a.CourseId == course.Id)
            .OrderBy(a => a.DueAt)
            .ToListAsync();

        EditAssignment = new Assignment { CourseId = course.Id };
    }

    private async Task SaveCourse()
    {
        var course = await DbContext.Courses.FindAsync(EditCourse.Id);

        if (course == null)
        {
            DbContext.Courses.Add(EditCourse);
        }
        else
        {
            course.Name = EditCourse.Name;
            course.Code = EditCourse.Code;
            course.Term = EditCourse.Term;
        }

        await DbContext.SaveChangesAsync();
        await LoadCourses();
    }

    private async Task DeleteCourse(Course course)
    {
        DbContext.Courses.Remove(course);
        await DbContext.SaveChangesAsync();
        await LoadCourses();
        SelectedCourse = null;
    }

    private void SelectAssignment(Assignment assignment)
    {
        EditAssignment = new Assignment
        {
            Id = assignment.Id,
            CourseId = assignment.CourseId,
            Name = assignment.Name,
            Description = assignment.Description,
            DueAt = assignment.DueAt
        };
    }

    private async Task SaveAssignment()
    {
        var assignment = await DbContext.Assignments.FindAsync(EditAssignment.Id);

        if (assignment == null)
        {
            DbContext.Assignments.Add(EditAssignment);
        }
        else
        {
            assignment.Name = EditAssignment.Name;
            assignment.Description = EditAssignment.Description;
            assignment.DueAt = EditAssignment.DueAt;
        }

        await DbContext.SaveChangesAsync();
        await SelectCourse(SelectedCourse!);
    }

    private async Task DeleteAssignment(Assignment assignment)
    {
        DbContext.Assignments.Remove(assignment);
        await DbContext.SaveChangesAsync();
        await SelectCourse(SelectedCourse!);
    }
}
