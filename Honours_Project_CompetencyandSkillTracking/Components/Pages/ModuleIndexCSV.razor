@page "/moduleindexcsv"
@using Microsoft.EntityFrameworkCore
@using Honours_Project_CompetencyandSkillTracking.Data
@using Honours_Project_CompetencyandSkillTracking.Components.Services
@rendermode InteractiveServer
@inject AppDbContext DbContext
@inject ModuleCSVReading CsvReader

<div class="container">

    <div class="row bg-light mb-4">
        <div class="p-3 bg-primary text-white text-center">
            Modules
        </div>
    </div>

        <table class="table table-bordered">
            <thead class="thead-dark">
                <tr>
                    <th>Course</th>
                    <th>Programme</th>
                    <th>Title</th>
                    <th>Module</th>
                    <th>Route</th>
                    <th>Award</th>
                    <th>Year</th>
                    <th>Trimester</th>
                    <th>Status</th>
                    <th>Level</th>
                    <th>Credits</th>
                    <th>Delete</th>
                </tr>
            </thead>
            <tbody>
                @if (Modules.Any())
                {
                    @foreach (var module in Modules)
                    {
                        <tr>
                            <td>@module.Course</td>
                            <td>@module.Programme</td>
                            <td>@module.Title</td>
                            <td>@module.ModuleName</td>
                            <td>@module.Route</td>
                            <td>@module.Award</td>
                            <td>@module.CBOYear</td>
                            <td>@module.Trimester</td>
                            <td>@module.SelectionStatus</td>
                            <td>@module.Level</td>
                            <td>@module.Credits</td>
                            <td>
                                <button class="btn btn-danger"
                                        @onclick="() => DeleteModule(module)"
                                        @onclick:stopPropagation="true">
                                    Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="10" class="text-center">
                            <strong>No modules found</strong>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

@code {
    private List<ModuleData> Modules = new();
    private string? StatusMessage;

    protected override async Task OnInitializedAsync()
    {
        await LoadModules();
    }

    private async Task LoadModules()
    {
        Modules = await DbContext.ModulesCSV
            .OrderBy(m => m.DatabaseID)
            .ToListAsync();
    }

    private async Task DeleteModule(ModuleData module)
    {
        var s = await DbContext.ModulesCSV.FindAsync(module.DatabaseID);
        if (s != null)
        {
            DbContext.ModulesCSV.Remove(s);
            await DbContext.SaveChangesAsync();
            await LoadModules();
        }
    }
}