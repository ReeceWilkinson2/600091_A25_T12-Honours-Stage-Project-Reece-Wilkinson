@page "/gradecalculator"
@rendermode InteractiveServer
@inject UserService service
@inject AuthStateService AuthState

<h3>Grade Calculator</h3>

@if (Courses.Any())
{
    <label>Select Course:</label>
    <select @onchange="OnCourseChanged" class="form-select mb-3">
        <option value="">-- Select Course --</option>
        @foreach (var course in Courses)
        {
            <option value="@course">@course</option>
        }
    </select>
}

@if (!string.IsNullOrEmpty(SelectedCourse))
{
    <h4>Year 2 Modules (30%)</h4>

    <label>Core Module:</label>
    <select class="form-select mb-2"
            value="@Year2Core.ModuleName"
            @onchange="e => Year2Core.ModuleName = e.Value?.ToString()">
        <option value="">-- Select Core --</option>
        @foreach (var m in Year2Modules.Where(x => x.SelectionStatus == "Core"))
        {
            <option value="@m.ModuleName">@m.ModuleName</option>
        }
    </select>

    @if (!string.IsNullOrEmpty(Year2Core.ModuleName))
    {
        @RenderAssignments(Year2Core)
    }

    <h5>T1</h5>
    @for (int i = 0; i < Year2T1.Count; i++)
    {
        var module = Year2T1[i];

        <select class="form-select mb-2"
                value="@module.ModuleName"
                @onchange="e => module.ModuleName = e.Value?.ToString()">
            <option value="">-- Module --</option>
            @foreach (var m in Year2Modules.Where(x =>
                (x.SelectionStatus == "Compulsory" || x.SelectionStatus == "Optional")
                && x.Trimester == "T1"))
            {
                <option value="@m.ModuleName">@m.ModuleName</option>
            }
        </select>

        @if (!string.IsNullOrEmpty(module.ModuleName))
        {
            @RenderAssignments(module)
        }
    }

    <h5>T2</h5>
    @for (int i = 0; i < Year2T2.Count; i++)
    {
        var module = Year2T2[i];

        <select class="form-select mb-2"
                value="@module.ModuleName"
                @onchange="e => module.ModuleName = e.Value?.ToString()">
            <option value="">-- Module --</option>
            @foreach (var m in Year2Modules.Where(x =>
                (x.SelectionStatus == "Compulsory" || x.SelectionStatus == "Optional")
                && x.Trimester == "T2"))
            {
                <option value="@m.ModuleName">@m.ModuleName</option>
            }
        </select>

        @if (!string.IsNullOrEmpty(module.ModuleName))
        {
            @RenderAssignments(module)
        }
    }

    <hr />

    <h4>Year 3 Modules (70%)</h4>

    <label>Elective Module:</label>
    <select class="form-select mb-2"
            value="@Year3Elective.ModuleName"
            @onchange="e => Year3Elective.ModuleName = e.Value?.ToString()">
        <option value="">-- Select Elective --</option>
        @foreach (var m in Year3Modules.Where(x => x.SelectionStatus == "Elective"))
        {
            <option value="@m.ModuleName">@m.ModuleName</option>
        }
    </select>

    @if (!string.IsNullOrEmpty(Year3Elective.ModuleName))
    {
        @RenderAssignments(Year3Elective)
    }

    <h5>T1</h5>
    @for (int i = 0; i < Year3T1.Count; i++)
    {
        var module = Year3T1[i];

        <select class="form-select mb-2"
                value="@module.ModuleName"
                @onchange="e => module.ModuleName = e.Value?.ToString()">
            <option value="">-- Module --</option>
            @foreach (var m in Year3Modules.Where(x =>
                (x.SelectionStatus == "Compulsory" || x.SelectionStatus == "Optional")
                && x.Trimester == "T1"))
            {
                <option value="@m.ModuleName">@m.ModuleName</option>
            }
        </select>

        @if (!string.IsNullOrEmpty(module.ModuleName))
        {
            @RenderAssignments(module)
        }
    }

    <h5>T2</h5>
    @for (int i = 0; i < Year3T2.Count; i++)
    {
        var module = Year3T2[i];

        <select class="form-select mb-2"
                value="@module.ModuleName"
                @onchange="e => module.ModuleName = e.Value?.ToString()">
            <option value="">-- Module --</option>
            @foreach (var m in Year3Modules.Where(x =>
                (x.SelectionStatus == "Compulsory" || x.SelectionStatus == "Optional")
                && x.Trimester == "T2"))
            {
                <option value="@m.ModuleName">@m.ModuleName</option>
            }
        </select>

        @if (!string.IsNullOrEmpty(module.ModuleName))
        {
            @RenderAssignments(module)
        }
    }

    <button class="btn btn-primary mt-3" @onclick="CalculateFinalGrade">
        Calculate Final Grade
    </button>

    @if (!string.IsNullOrEmpty(CalculationError))
    {
        <div class="text-danger mt-2">@CalculationError</div>
    }

    @if (FinalGrade != null)
    {
        <h4 class="mt-2">
            Final Grade: @FinalGrade.Value.ToString("0.00")% - @GetGradeClassification(FinalGrade.Value)
        </h4>
    }

    @if (student?.Submissions != null && student.Submissions.Any())
    {
        <div class="scrollable-box">
            @foreach (var submission in student.Submissions)
            {
                <ul>
                    <li>
                        <strong>@submission.Assignment.Name</strong>
                        - Score: @submission.Score
                        - Weighting: @submission.Assignment.Weighting%
                        <br />
                    </li>
                </ul>
            }
        </div>
    }
    else
    {
        <p>No submissions found.</p>
    }
}

@code {
    private User? student;
    private List<string> Courses = new();
    private List<ModuleData> Year2Modules = new();
    private List<ModuleData> Year3Modules = new();
    private string? SelectedCourse;

    private List<ModuleSelection> Year2T1 = new() { new(), new() };
    private List<ModuleSelection> Year2T2 = new() { new(), new() };
    private ModuleSelection Year2Core = new();

    private List<ModuleSelection> Year3T1 = new() { new(), new() };
    private List<ModuleSelection> Year3T2 = new() { new(), new() };
    private ModuleSelection Year3Elective = new();

    private decimal? FinalGrade;
    private string? CalculationError;

    protected override async Task OnInitializedAsync()
    {
        await AuthState.InitializeAsync();

        if (!AuthState.IsInitialized || string.IsNullOrEmpty(AuthState.UserId))
        {
            return;
        }

        student = await service.GetUserByIdAsync(AuthState.UserId);

        if (student != null)
        {
            student.Submissions = student.Submissions ?? new List<Submission>();
        }

        Courses = await service.GetAllCourseTitlesAsync();
    }

    private async Task OnCourseChanged(ChangeEventArgs e)
    {
        SelectedCourse = e.Value?.ToString();

        if (!string.IsNullOrEmpty(SelectedCourse))
        {
            Year2Modules = await service.GetModuleDataAsync(SelectedCourse, "5");
            Year3Modules = await service.GetModuleDataAsync(SelectedCourse, "6");

            Year2T1 = new() { new(), new() };
            Year2T2 = new() { new(), new() };
            Year3T1 = new() { new(), new() };
            Year3T2 = new() { new(), new() };
            Year2Core = new();
            Year3Elective = new();
        }
    }

    public class ModuleSelection
    {
        public string? ModuleName { get; set; }
        public List<AssignmentInput> Assignments { get; set; } = new();
    }

    public class AssignmentInput
    {
        public string Name { get; set; } = "";
        public decimal Score { get; set; }
        public decimal Weighting { get; set; }
    }

    private decimal? CalculateModuleGrade(List<AssignmentInput> assignments)
    {
        if (assignments == null || assignments.Count == 0)
            return null;

        if (assignments.Sum(a => a.Weighting) != 100)
            return null;

        return assignments.Sum(a => a.Score * (a.Weighting / 100m));
    }

    private decimal? CalculateYear(List<ModuleData> modules, List<ModuleSelection> selected)
    {
        decimal totalCredits = 0;
        decimal weighted = 0;

        foreach (var sel in selected)
        {
            if (string.IsNullOrEmpty(sel.ModuleName))
                return null;

            var mod = modules.FirstOrDefault(m => m.ModuleName == sel.ModuleName);
            var grade = CalculateModuleGrade(sel.Assignments);

            if (mod == null || grade == null)
                return null;

            weighted += grade.Value * mod.Credits;
            totalCredits += mod.Credits;
        }

        return totalCredits == 0 ? null : weighted / totalCredits;
    }

    private void CalculateFinalGrade()
    {
        CalculationError = null;

        var y2 = Year2T1.Concat(Year2T2).Append(Year2Core).ToList();
        var y3 = Year3T1.Concat(Year3T2).Append(Year3Elective).ToList();

        var y2Avg = CalculateYear(Year2Modules, y2);
        var y3Avg = CalculateYear(Year3Modules, y3);

        if (y2Avg == null || y3Avg == null)
        {
            CalculationError = "Please complete all modules and ensure each weighting = 100%.";
            FinalGrade = null;
            return;
        }

        FinalGrade = (y2Avg * 0.30m) + (y3Avg * 0.70m);
    }

    private string GetGradeClassification(decimal grade)
    {
        if (grade >= 70) return "1st";
        if (grade >= 60) return "2:1";
        if (grade >= 50) return "2:2";
        if (grade >= 40) return "3rd";
        return "Fail";
    }

    private RenderFragment RenderAssignments(ModuleSelection module) => builder =>
    {
        int seq = 0;

        if (!module.Assignments.Any())
            module.Assignments.Add(new AssignmentInput());

        builder.OpenElement(seq++, "div");

        for (int i = 0; i < module.Assignments.Count; i++)
        {
            var item = module.Assignments[i];

            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "class", "d-flex gap-2 mb-2");

            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "form-label");
            builder.AddContent(seq++, "Assignment Name:");
            builder.CloseElement();

            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "class", "form-control");
            builder.AddAttribute(seq++, "value", item.Name);
            builder.AddAttribute(seq++, "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(this,
                    e => item.Name = e.Value?.ToString() ?? ""));
            builder.CloseElement();

            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "form-label");
            builder.AddContent(seq++, "Score:");
            builder.CloseElement();

            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "class", "form-control");
            builder.AddAttribute(seq++, "value", item.Score);
            builder.AddAttribute(seq++, "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                {
                    decimal.TryParse(e.Value?.ToString(), out var v);
                    item.Score = v;
                }));
            builder.CloseElement();

            builder.OpenElement(seq++, "label");
            builder.AddAttribute(seq++, "class", "form-label");
            builder.AddContent(seq++, "Weighting:");
            builder.CloseElement();

            builder.OpenElement(seq++, "input");
            builder.AddAttribute(seq++, "type", "number");
            builder.AddAttribute(seq++, "class", "form-control");
            builder.AddAttribute(seq++, "value", item.Weighting);
            builder.AddAttribute(seq++, "oninput",
                EventCallback.Factory.Create<ChangeEventArgs>(this, e =>
                {
                    decimal.TryParse(e.Value?.ToString(), out var v);
                    item.Weighting = v;
                }));
            builder.CloseElement();

            builder.OpenElement(seq++, "button");
            builder.AddAttribute(seq++, "class", "btn btn-danger");
            builder.AddAttribute(seq++, "onclick",
                EventCallback.Factory.Create(this, () => module.Assignments.Remove(item)));
            builder.AddContent(seq++, "X");
            builder.CloseElement();

            builder.CloseElement();
        }

        builder.OpenElement(seq++, "button");
        builder.AddAttribute(seq++, "class", "btn btn-success");
        builder.AddAttribute(seq++, "onclick",
            EventCallback.Factory.Create(this, () => module.Assignments.Add(new AssignmentInput())));
        builder.AddContent(seq++, "Add Assignment");
        builder.CloseElement();

        var total = module.Assignments.Sum(x => x.Weighting);

        builder.OpenElement(seq++, "div");
        builder.AddContent(seq++, $"Total Weighting: {total}%");
        builder.CloseElement();

        if (total != 100)
        {
            builder.OpenElement(seq++, "div");
            builder.AddAttribute(seq++, "style", "color:red");
            builder.AddContent(seq++, "⚠ Must equal 100%");
            builder.CloseElement();
        }

        builder.CloseElement();
    };
}