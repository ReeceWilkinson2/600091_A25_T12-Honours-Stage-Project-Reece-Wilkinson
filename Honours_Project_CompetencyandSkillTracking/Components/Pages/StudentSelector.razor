@page "/studentselection"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject UserService service

<div>
    @foreach (var student in Students)
    {
        <button @onclick="() => LoadStudentDetails(student)">@student.StudentId, @student.UserName</button>
    }
</div>

@code {
    private List<User> Students = new List<User>();

    protected override async Task OnInitializedAsync()
    {
        Students = await service.GetStudentDataAsync("Student");
    }

    private void LoadStudentDetails(User student)
    {
        // Needs to get all current students to be selected to show their information - requires competency data.
        // Console.WriteLine($"Loading details for student: {student.UserName}");
        NavigationManager.NavigateTo($"/studentviewer/{student.StudentId}");
    }
}