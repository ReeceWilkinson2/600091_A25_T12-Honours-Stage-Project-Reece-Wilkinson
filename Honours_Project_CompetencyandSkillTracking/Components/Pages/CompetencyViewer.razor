@page "/competencyviewer/{CompetencyID}"
@rendermode InteractiveServer

@inject NavigationManager NavigationManager
@inject CompetencyDataServices service
@inject AppDbContext dbContext

<div style="margin-bottom:10px">
    <button class="module-button" @onclick="ReturnToSelection">
        ← Back to Selection
    </button>
</div>

@if (Competency != null)
{
    <div>
        <h3>Competency Details: @Competency.CompetencyName</h3>

        <h4>Competency ID: @Competency.CompetencyCode</h4>

        @if (Competency.Levels?.Any() == true)
        {
            @foreach (var level in Competency.Levels.OrderBy(l => l.LevelNumber))
            {
                <div class="level-section">
                    <h5>Level @level.LevelNumber</h5>

                    <p>@level.Description</p>

                    @if (level.Modules?.Any() == true)
                    {
                        <p><strong>Modules covered in:</strong></p>

                        <ul>
                            @foreach (var clm in level.Modules)
                            {
                                <li>
                                    @clm.Module?.ModCode - @clm.Module?.ModuleName
                                </li>
                            }
                        </ul>
                    }
                    else
                    {
                        <p><strong>Modules:</strong> Not Assigned</p>
                    }
                </div>
            }
        }
        else
        {
            <p>No level information available.</p>
        }

        <h4>Additional Notes:</h4>
        <p>@Competency.AdditionalNotes</p>
    </div>
}
else
{
    <p>Loading didn't work</p>
}

@code {
    [Parameter] public string CompetencyID { get; set; } = "";

    private CompetencyData? Competency;

    protected override async Task OnInitializedAsync()
    {
        Competency = await dbContext.CompetencyData
            .Include(c => c.Levels)
                .ThenInclude(l => l.Modules)
                    .ThenInclude(clm => clm.Module)
            .FirstOrDefaultAsync(c => c.CompetencyCode == CompetencyID);
    }

    private void ReturnToSelection()
    {
        NavigationManager.NavigateTo("/competencyselection");
    }
}