@page "/competencyviewer/{CompetencyID}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CompetencyDataServices service

<h3>Competency Details</h3>

@if (Competency != null)
{
    <div>
        <h4>@Competency.CompetencyName</h4>
        <p>Competency ID: @Competency.CompetencyID</p>
        <p>Module covered in: @Competency.Module</p>
        <p>Course covered in: @Competency.Course</p>
        <p>Level 4: @Competency.Level4Description</p>
        <p>Level 5: @Competency.Level5Description</p>
        <p>Level 6: @Competency.Level6Description</p>
		<p>Additional Notes: @Competency.AdditionalNotes</p>
    </div>
}
else
{
    <p>Loading didn't work</p>
}

@code {
	[Parameter] public string CompetencyID { get; set; }
	private CompetencyData Competency;

    protected override async Task OnInitializedAsync()
    {
        Competency = await service.GetCompetencyByIdAsync(CompetencyID);
    }
}
