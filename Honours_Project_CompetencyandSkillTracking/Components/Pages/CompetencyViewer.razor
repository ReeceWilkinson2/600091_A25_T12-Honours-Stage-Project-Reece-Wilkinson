@page "/competencyviewer/{CompetencyID}"
@rendermode InteractiveServer
@inject NavigationManager NavigationManager
@inject CompetencyDataServices service

<h2>Competency Details</h2>

@if (Competency != null)
{
    <div>
        <h3>@Competency.CompetencyName</h3>
        <h4>Competency ID: </h4>
        <p>@Competency.CompetencyID</p>
        <h4>Module covered in: </h4>
        <p>@Competency.Module</p>
        <h4>Course covered in: </h4>
        <p>@Competency.Course</p>
        @if (Competency.Levels != null && Competency.Levels.Any())
        {
            @foreach (var level in Competency.Levels.OrderBy(l => l.LevelNumber))
            {
                <div class="level-section">
                    <h4>Level @level.LevelNumber:</h4>
                    <p>@level.Description</p>
                </div>
            }
        }
        else
        {
            <p>No level information available.</p>
        }
        <h4>Additional Notes: </h4>
		<p>@Competency.AdditionalNotes</p>
    </div>
}
else
{
    <p>Loading didn't work</p>
}

@code {
	[Parameter] public string CompetencyID { get; set; }
	private CompetencyData Competency;

    protected override async Task OnInitializedAsync()
    {
        Competency = await service.GetCompetencyByIdAsync(CompetencyID);
    }
}
