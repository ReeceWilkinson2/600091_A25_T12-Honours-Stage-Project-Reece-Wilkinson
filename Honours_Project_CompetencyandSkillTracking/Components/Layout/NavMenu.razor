@inject IAuthStateService AuthState
@inject NavigationManager NavigationManager

<div class="nav-scrollable sidebar">

    <nav class="nav flex-column nav-pills p-1">

        @if (!AuthState.IsInitialized)
        {
            <span class="nav-link text-muted">Loading...</span>
        }
        else if (!string.IsNullOrEmpty(AuthState.Role))
        {
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>

            @if (AuthState.Role == "Student")
            {
                <NavLink class="nav-link" href="competencyselection">
                    <span class="bi bi-list-ul"></span> Competency Catalogue
                </NavLink>

                @* <NavLink class="nav-link" href="courseindex">
                    <span class="bi bi-list-nested"></span> My Modules
                </NavLink> *@

                <NavLink class="nav-link" href="studentjourney">
                    <span class="bi bi-graph-up"></span> Student Journey
                </NavLink>

                <NavLink class="nav-link" href="gradecalculator">
                    <span class="bi bi-list-nested"></span> Grade Calculator
                </NavLink>

                @* <NavLink class="nav-link" href="submissionindex">
                    <span class="bi bi-file-earmark-text"></span> My Submissions
                </NavLink> *@
            }

            @if (AuthState.Role == "Staff")
            {
                <NavLink class="nav-link" href="competencyselection">
                    <span class="bi bi-list-nested"></span> Competency Catalogue
                </NavLink>

                <NavLink class="nav-link" href="studentselection">
                    <span class="bi bi-people"></span> Student Search
                </NavLink>

              @*   <NavLink class="nav-link" href="datacreation">
                    <span class="bi bi-file-plus"></span> Data Creation
                </NavLink> *@
            }

            @if (AuthState.Role == "Employer")
            {
                <NavLink class="nav-link" href="competencyselection">
                    <span class="bi bi-list-nested"></span> Competency Catalogue
                </NavLink>

                <NavLink class="nav-link" href="studentselection">
                    <span class="bi bi-people"></span> Student Search
                </NavLink>
            }

            @if (AuthState.Role == "Admin")
            {
                <NavLink class="nav-link" href="competencyselection">
                    <span class="bi bi-list-nested"></span> Competency Catalogue
                </NavLink>

                <NavLink class="nav-link" href="studentselection">
                    <span class="bi bi-list-nested"></span> Student Search
                </NavLink>

                <NavLink class="nav-link" href="userindex">
                    <span class="bi bi-person-badge"></span> User Index
                </NavLink>

                <NavLink class="nav-link" href="courseindex">
                    <span class="bi bi-list-nested"></span> Module Index (Canvas)
                </NavLink>

                <NavLink class="nav-link" href="moduleindexcsv">
                    <span class="bi bi-list-nested"></span> Module Index (CSV)
                </NavLink>

                <NavLink class="nav-link" href="submissionindex">
                    <span class="bi bi-list-nested"></span> Submission Index
                </NavLink>

                <NavLink class="nav-link" href="sync">
                    <span class="bi bi-arrow-repeat"></span> Data Sync
                </NavLink>

                <NavLink class="nav-link" href="datacreation">
                    <span class="bi bi-file-plus"></span> Data Creation
                </NavLink>
            }

            <a class="nav-link text-danger" style="cursor:pointer;" @onclick="Logout">
                <span class="bi bi-box-arrow-right"></span> Logout
            </a>
        }
        else
        {
            <NavLink class="nav-link" href="">
                <span class="bi bi-box-arrow-in-right"></span> Sign In
            </NavLink>
        }

    </nav>
</div>

@code {
    private async Task Logout()
    {
        await AuthState.ClearAsync();
        NavigationManager.NavigateTo("/");
    }

    protected override void OnInitialized()
    {
        AuthState.OnChange += StateHasChanged;
    }
}