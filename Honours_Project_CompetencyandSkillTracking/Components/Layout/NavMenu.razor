@inherits LayoutComponentBase

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Honours_Project_CompetencyandSkillTracking</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="competencyselection">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> CompetencyCatalogue
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="studentselection">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> StudentSearch
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="userindex">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> User Index
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="courseindex">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Module Index
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="submissionindex">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Submission Index
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="sync">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Canvas Sync
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="signin">
                <span class="bi bi-list-nested-nav-menu" aria-hidden="true"></span> Sign-In 
            </NavLink>
        </div>
    </nav>
</div>


