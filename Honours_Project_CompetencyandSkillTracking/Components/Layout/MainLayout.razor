@using Honours.Services
@using Honours_Project_CompetencyandSkillTracking.Components.Layout
@inherits LayoutComponentBase
@inject UserInfoService userInfoService

<div class="page">
    <div class="sidebar">
        <NavMenu />
    </div>

    <main>
        <div class="top-row px-4">
            <NavLink class="nav-link" href="settings">
                <span target="_blank" class="bi bi-gear-fill h1" aria-hidden="true" style="color:#f7f7f7" title="Profile"></span>
            </NavLink>
        </div>

        <article class="content px-4">
            <CascadingValue Value="@userInfoService.UserInfo">
                @Body
            </CascadingValue>

        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
